---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import FinalCTA from '../components/FinalCTA.astro';
import MagazaButonlari from '../components/MagazaButonlari.astro';
import kartVakitler from '../assets/gorseller/kart-vakitler.png';

// İçerik kaynağı: UYGULAMA_OZELLIKLERI.md §6 + SSS ("Namaz vakitleri nasıl
// hesaplanıyor?"). Yalnız belgelenmiş davranışlar anlatılır.
const title = 'Namaz Vakitleri Uygulaması | İbadet Rehberim';
const description =
  'Günün altı vakti Diyanet hesabıyla ilçenize göre listelenir; sonraki vakte kalan süreyi görür, vakit girince bildirim alırsınız. Ücretsiz ve Türkçe.';

const maddeler = [
  {
    baslik: 'Diyanet hesabıyla, ilçe hassasiyetinde',
    metin:
      'Vakitler, Diyanet İşleri Başkanlığının hesaplama yöntemiyle hazırlanır ve seçtiğiniz ilçeye göre listelenir. "Yer seç" ile ilçenizi değiştirdiğinizde liste anında güncellenir.',
  },
  {
    baslik: 'Sıradaki vakit hep gözünüzün önünde',
    metin:
      'İçinde bulunduğunuz vakit listede vurgulanır; bir sonraki vakte kalan süre "1 saat 49 dakika" gibi açık bir metinle gösterilir ve her dakika yenilenir.',
  },
  {
    baslik: 'Hatırlatmalar sizin kontrolünüzde',
    metin:
      'Vakit girince bildirim alırsınız. İstemediğiniz gün ayarlardan tek dokunuşla kapatır, dilediğinizde yeniden açarsınız.',
  },
];

const kirinti = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Namaz Vakitleri' },
  ],
};
---

<Base title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(kirinti)} />
  <main>
    <section class="kapsayici pt-[clamp(3rem,8vw,5.5rem)] pb-[clamp(2.5rem,6vw,4rem)]">
      <div class="grid items-center gap-12 lg:grid-cols-[7fr_5fr] lg:gap-8">
        <div class="max-w-[560px]">
          <p class="giris-1 eyebrow">Namaz vakitleri</p>
          <h1 class="giris-2 mt-6">
            Günün altı vakti, <span class="text-vurgu-koyu">ilçenize göre</span>
          </h1>
          <p class="giris-3 mt-5 max-w-[46ch] text-[1.125rem] leading-[1.7] text-soluk">
            İmsak, Güneş, Öğle, İkindi, Akşam ve Yatsı tek listede. Sonraki vakte ne
            kadar kaldığını anlık görürsünüz; vakti gelince uygulama size haber verir.
          </p>
          <div class="giris-4 mt-8">
            <MagazaButonlari />
          </div>
        </div>

        <!-- Çerçeve, köşe ve gölge görselin içindedir (GORSELLER.md §3) -->
        <div class="giris-4">
          <Image
            src={kartVakitler}
            alt="İbadet Rehberim ezan vakitleri ekranı: günün altı vakti ve sonraki vakte kalan süre"
            width={420}
            densities={[1, 2]}
            class="mx-auto h-auto w-[min(85%,420px)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section class="bolum cizgi border-y bg-yuzey">
      <div class="kapsayici">
        <h2 class="reveal max-w-[24ch]">Ekranda sizi ne karşılar?</h2>
        <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
          {
            maddeler.map((madde, i) => (
              <li class="reveal cizgi border-t pt-6" style={`--gecikme: ${0.1 + i * 0.12}s`}>
                <h3 class="text-[1.35rem]">{madde.baslik}</h3>
                <p class="mt-3 leading-[1.7] text-soluk">{madde.metin}</p>
              </li>
            ))
          }
        </ul>
        <p class="reveal mt-12 max-w-[62ch] leading-[1.7] text-soluk" style="--gecikme: 0.2s">
          Namaz sonrası tesbihatınızı da aynı uygulamada sayabilirsiniz —
          <a href="/zikirmatik" class="text-vurgu-koyu underline">akıllı zikirmatik</a>
          namaz için zikir setini tek dokunuşla kurar. Merak ettikleriniz için
          <a href="/#sss" class="text-vurgu-koyu underline">sıkça sorulan sorulara</a> bakabilirsiniz.
        </p>
      </div>
    </section>

    <FinalCTA />
  </main>
  <Footer />
</Base>
