const sorular = [
  {
    soru: 'Ojeyle abdest olur mu?',
    cevap:
      'Suyun tırnağa ulaşmasını engelleyen bir tabaka oluşturduğu için ojeyle alınan abdest geçerli olmaz; abdestten önce çıkarılması gerekir. Suyu geçiren kına ise abdeste engel değildir.',
    kaynak: 'İslam İlmihali, s. 101',
  },
  {
    soru: "Abdestsiz Kur'an okunur mu?",
    cevap:
      "Abdestsiz biri Kur'an'ı ezberden okuyabilir, ama Mushaf'a el süremez; ayrı bir kılıf veya kapla tutabilir. Çocukların abdestsiz tutmasında sakınca yoktur.",
