---
import Rehber from '../../layouts/Rehber.astro';
import type { Baslik, Kaynak } from '../../layouts/Rehber.astro';

// İçerik kaynağı: Diyanet İşleri Başkanlığı, İslam İlmihali (34. baskı,
// 2019), "V. Abdest" bölümü s. 96–112; adım sırası "F) Abdest Nasıl
// Alınır?" (s. 105–107) ile DİYK "Abdest nedir ve nasıl alınır?" fetvasından.
// Metinde verilen her sayfa numarası bu baskıya göredir. Adım etiketleri:
// farz s. 98–99, sünnet s. 101–104, edep s. 104–105.
const ilmihal =
  'https://diniyayinlar.diyanet.gov.tr/Documents/islam%20ilmihali%2017%20X%2024%20.pdf';

const kaynaklar: Kaynak[] = [
  {
    ad: 'Diyanet İşleri Başkanlığı, İslam İlmihali',
    ayrinti: 'Lütfi Şentürk ve Seyfettin Yazıcı, 34. baskı, Ankara 2019, "Abdest" bölümü, s. 96–112',
    url: ilmihal,
  },
  {
    ad: 'Din İşleri Yüksek Kurulu, "Abdest nedir ve nasıl alınır?"',
    ayrinti: 'fetva, 12 Temmuz 2017',
    url: 'https://kurul.diyanet.gov.tr/tr/fetva/abdest-nedir-ve-nasil-alinir/0193c42d-4493-7cd5-0d48-874d6be1a7d3',
  },
  {
    ad: 'Din İşleri Yüksek Kurulu, "Mezhepler arasında abdestin farzları konusunda farklılık var mıdır?"',
    ayrinti: 'fetva',
    url: 'https://kurul.diyanet.gov.tr/tr/fetva/mezhepler-arasinda-abdestin-farzlari-konusunda-farklilik-var-midir/0193c42d-44c2-71a2-18f9-9a29fcdbaa43',
  },
  { ad: "Kur'an-ı Kerim, Mâide suresi 5/6" },
];

const basliklar: Baslik[] = [
  { id: 'adim-adim', ad: 'Adım adım abdest' },
  { id: 'farzlar', ad: 'Abdestin farzları' },
  { id: 'sunnetler', ad: 'Abdestin sünnetleri' },
  { id: 'bozan', ad: 'Abdesti bozan ve bozmayanlar' },
  { id: 'mekruhlar', ad: 'Abdestin mekruhları' },
  { id: 'dualar', ad: 'Abdest duaları' },
  { id: 'sorular', ad: 'Sık sorulan sorular' },
];

type Hukum = 'Farz' | 'Sünnet' | 'Edep';
const adimlar: { baslik: string; hukum: Hukum; kez?: string; metin: string }[] = [
  {
    baslik: 'Hazırlık',
    hukum: 'Edep',
    metin:
      'Kollarınızı dirseklerin üstüne kadar sıvayın. İmkânınız varsa suyun üzerinize sıçramaması için yüksekçe bir yerde, kıbleye dönerek durun.',
  },
  {
    baslik: 'Niyet ve besmele',
    hukum: 'Sünnet',
    metin:
      'Kalbinizden niyet edin; dilinizle de <strong>“Niyet ettim Allah rızası için abdest almaya”</strong> diyebilirsiniz. Ardından <em>“Eûzü billâhi mine’ş-şeytâni’r-racîm. Bismillâhi’r-Rahmâni’r-Rahîm”</em> deyin.',
  },
  {
    baslik: 'Eller',
    hukum: 'Sünnet',
    kez: '3 kere',
    metin:
      'Ellerinizi bileklere kadar yıkayın. Parmak aralarını birbirine geçirerek ovun. Yüzük takıyorsanız suyun altına ulaşması için yüzüğü oynatın.',
  },
  {
    baslik: 'Ağız',
    hukum: 'Sünnet',
    kez: '3 kere',
    metin: 'Sağ avucunuzla ağzınıza su alın ve her seferinde iyice çalkalayın.',
  },
  {
    baslik: 'Burun',
    hukum: 'Sünnet',
    kez: '3 kere',
    metin: 'Yine sağ avucunuzla burnunuza su çekin; her seferinde sol elinizle sümkürerek burnunuzu temizleyin.',
  },
  {
    baslik: 'Yüz',
    hukum: 'Farz',
    kez: '3 kere',
    metin:
      'Alnın üst tarafından başlayarak yüzünüzün her yerini yıkayın. Sakalınız varsa parmaklarınızla aralayın; seyrekse suyun deriye ulaşmasını sağlayın.',
  },
  {
    baslik: 'Kollar',
    hukum: 'Farz',
    kez: '3 kere',
    metin: 'Önce sağ kolunuzu, sonra sol kolunuzu dirseklerle beraber yıkayın.',
  },
  {
    baslik: 'Baş',
    hukum: 'Farz',
    kez: 'mesh',
    metin:
      'Ellerinizi ıslatın ve sağ elinizin içiyle başınızın <strong>en az dörtte birini</strong> meshedin; farz böylece yerine gelir. Başın tamamını meshetmek isterseniz ıslak iki elinizi parmaklarla birlikte başın ön tarafına koyup arkaya doğru sıvazlayın.',
  },
  {
    baslik: 'Kulaklar',
    hukum: 'Sünnet',
    kez: 'mesh',
    metin:
      'Şehadet parmaklarınızla kulaklarınızın içini, başparmaklarınızla dışını meshedin. Ellerinizde ıslaklık kalmadıysa önce yeniden ıslatın.',
  },
  {
    baslik: 'Boyun',
    hukum: 'Sünnet',
    kez: 'mesh',
    metin: 'Yeni su almadan, iki elinizin arkasıyla boynunuzu meshedin.',
  },
  {
    baslik: 'Ayaklar',
    hukum: 'Farz',
    kez: '3 kere',
    metin:
      'Önce sağ, sonra sol ayağınızı topuklarla beraber yıkayın. Parmak uçlarından başlayın; parmak aralarını sağ ayağın küçük parmağından başlayıp sol ayağın küçük parmağında bitirecek şekilde temizleyin.',
  },
  {
    baslik: 'Kelime-i şehadet',
    hukum: 'Edep',
    metin: 'Abdest bitince kıbleye dönüp kelime-i şehadet getirin.',
  },
];

const farzlar = [
  {
    baslik: 'Yüzü bir kere yıkamak',
    metin:
      'Yüz; alında saçın bittiği yerden çene altına, iki kulak yumuşağı arasına kadar olan yerdir. Kirpikler ve göz pınarları da yıkanır, gözün içi yıkanmaz. Sık sakalın yalnız üstünü yıkamak yeterlidir.',
  },
  {
    baslik: 'Kolları dirseklerle beraber bir kere yıkamak',
    metin: 'Eller ve kollar, dirsekler de dahil olmak üzere yıkanır; dirseklerin yukarısını yıkamak gerekmez.',
  },
  {
    baslik: 'Başın dörtte birini meshetmek',
    metin:
      'Mesh, ıslak eli değdirmektir. Kolları yıkadıktan sonra elde kalan suyla mesh olmaz; başı meshetmek için yeni su alınır.',
  },
  {
    baslik: 'Ayakları topuklarla beraber bir kere yıkamak',
    metin: 'Topuklar da yıkanır. Çıplak ayağa mesh etmek caiz değildir.',
  },
];

const sunnetler = [
  'Abdeste başlarken elleri bileklere kadar yıkamak.',
  'Eûzü ve Besmele ile başlamak.',
  'Niyet etmek. Niyet kalple olur; dille söylemek müstehaptır.',
  'Dişleri misvak veya fırçayla, bunlar yoksa parmakla temizlemek.',
  'Ağza üç kere su alıp çalkalamak (mazmaza) ve buruna üç kere su çekmek (istinşak).',
  'Ayetteki sıraya uymak: önce yüz, sonra kollar, sonra baş, en son ayaklar.',
  'Kolları ve ayakları yıkarken sağdan başlamak.',
  'Her organı üç kere yıkamak (ilki farz, diğer ikisi sünnettir).',
  'Elleri ve ayakları yıkamaya parmak uçlarından başlamak ve parmak aralarını ovmak.',
  'Sık sakalı parmaklarla aşağıdan yukarıya doğru aralamak.',
  'Başın tamamını meshetmek, kulakları ve boynu meshetmek.',
  'Organları iyice ovarak yıkamak.',
  'Organları ara vermeden, biri kurumadan diğerine geçerek yıkamak.',
];

const bozanlar = [
  'Ön ve arkadan idrar, dışkı gibi bir şey çıkması ve arkadan yel çıkması.',
  'Vücudun herhangi bir yerinden kan veya irin akması. Ağızdan gelen kan tükürükle eşit ya da ondan fazlaysa bozar, azsa bozmaz; bu, tükürüğün renginden anlaşılır.',
  'Ağız dolusu kusmak.',
  'Yatarak ya da alındığında düşecek şekilde bir şeye yaslanarak uyumak.',
  'Bayılmak.',
  'Akıl hastalığı sebebiyle aklın gitmesi.',
  'Sarhoş olmak.',
  'Namazda yanındakinin duyacağı kadar sesli gülmek. Bu hem namazı hem abdesti bozar; gülümsemek ikisini de bozmaz.',
  'Eşlerin tenasül organlarının arada bir şey olmadan birbirine değmesi.',
];

const bozmayanlar = [
  'Çıktığı yerde kalıp etrafa yayılmayan kan.',
  'Ağız dolusundan az kusmak ve balgam tükürmek.',
  'Diş fırçasında, kürdanda ya da ısırılan bir şeyde görülen ama akmayan kan.',
  'Hastalık sebebiyle olmayan, ağlamaktan veya gülmekten akan göz yaşı.',
  'Bağdaş kurarak ya da dizüstü oturarak uyumak; namazda uyumak.',
];

const dualar = [
  {
    ne: 'Abdeste başlarken',
    okunus: 'El-hamdü lillâhillezî ce’ale’l-mâe tahûren ve ce’ale’l-islâme nûrâ.',
    anlam: "Suyu temizleyici ve İslam'ı nur kılan Allah'a hamdolsun.",
  },
  {
    ne: 'Ağza su alırken',
    okunus: 'Allâhümme’skınî min havzi nebiyyike ke’sen lâ ezmeu ba’dehu ebedâ.',
    anlam: 'Allahım! Bana peygamberin havuzundan öyle bir kâse içir ki ondan sonra bir daha susamayayım.',
  },
  {
    ne: 'Buruna su alırken',
    okunus: 'Allâhümme lâ tahrimnî râihate naîmike ve cennâtik.',
    anlam: 'Allahım! Beni nimetlerinin ve cennetlerinin kokusundan mahrum etme.',
  },
  {
    ne: 'Yüzü yıkarken',
    okunus: 'Allâhümme beyyid vechî binûrike yevme tebyeddu vücûhun ve tesveddu vücûh.',
    anlam: 'Allahım! Bazı yüzlerin beyazlanacağı bazı yüzlerin de kararacağı günde benim yüzümü ak eyle.',
  },
  {
    ne: 'Sağ kolu yıkarken',
    okunus: 'Allâhümme a’tinî kitabî biyeminî ve hâsibnî hisâben yesîrâ.',
    anlam: 'Allahım! Bana kitabımı sağ tarafımdan ver ve hesabımı kolaylaştır.',
  },
  {
    ne: 'Sol kolu yıkarken',
    okunus: 'Allâhümme lâ tü’ti kitabî bişimalî ve lâ min verâi zahrî ve lâ tuhasibnî hisaben şedîdâ.',
    anlam: 'Allahım! Bana kitabımı solumdan ve arka tarafımdan verme ve beni zor bir hesaba çekme.',
  },
  {
    ne: 'Başı meshederken',
    okunus: 'Allâhümme ğaşşinî birahmetike ve enzil aleyye min berakâtik.',
    anlam: 'Allahım! Beni rahmetinle ört ve üzerime bereketlerinden indir.',
  },
  {
    ne: 'Kulakları meshederken',
    okunus: 'Allâhümmec’alnî minellezîne yestemi’ûne’l-kavle fe yettebiûne ahseneh.',
    anlam: 'Allahım! Beni, hak sözü işitip sözün en güzeline uyanlardan eyle.',
  },
  {
    ne: 'Boynu meshederken',
    okunus: 'Allâhümme a’tık rekabetî mine’n-nâr.',
    anlam: 'Allahım! Benim vücudumu cehennem ateşinden azâd eyle.',
  },
  {
    ne: 'Ayakları yıkarken',
    okunus: 'Allâhümme sebbit kademeyye ale’s-sirâti yevme tezillü fîhi’l-akdâm.',
    anlam: 'Allahım! Ayakların kayacağı günde benim iki ayağımı sırat üzerinde sağlam tut.',
  },
];

const sorular = [
  {
    soru: 'Ojeyle abdest olur mu?',
    cevap:
      'Suyun tırnağa ulaşmasını engelleyen bir tabaka oluşturduğu için ojeyle alınan abdest geçerli olmaz; abdestten önce çıkarılması gerekir. Suyu geçiren kına ise abdeste engel değildir.',
    kaynak: 'İslam İlmihali, s. 101',
  },
  {
    soru: "Abdestsiz Kur'an okunur mu?",
    cevap:
      "Abdestsiz biri Kur'an'ı ezberden okuyabilir, ama Mushaf'a el süremez; ayrı bir kılıf veya kapla tutabilir. Çocukların abdestsiz tutmasında sakınca yoktur.",
    kaynak: 'İslam İlmihali, s. 112',
  },
  {
    soru: 'Abdest vakit girmeden alınabilir mi?',
    cevap:
      'Evet. Vakit girmeden önce abdest almak abdestin edeplerindendir. Yalnız sürekli idrar kaçırma gibi bir özrü olanlar abdestlerini vakit girdikten sonra alır. Vakitleri takip etmek için <a href="/namaz-vakitleri/">namaz vakitleri</a> sayfamıza göz atabilirsiniz.',
    kaynak: 'İslam İlmihali, s. 104',
  },
  {
    soru: 'Abdest organında yara ya da sargı varsa ne yapılır?',
    cevap:
      'Yarayı yıkamak zarar veriyorsa üzerine mesh edilir; o da zararlıysa terk edilir. Sargı varsa ve çözmek zarar verecekse ıslak elle sargının üzerine bir kere mesh edilir. Bu mesh, yara iyileşinceye kadar geçerlidir.',
    kaynak: 'İslam İlmihali, s. 101, 114',
  },
  {
    soru: 'Abdesti olmayan neleri yapamaz?',
    cevap:
      "Abdestsiz namaz kılınmaz, Kâbe tavaf edilmez ve Kur'an'a el sürülmez. Tilavet secdesi için de abdest farzdır.",
    kaynak: 'İslam İlmihali, s. 105, 111–112',
  },
];
---

<Rehber
  title="Abdest Nasıl Alınır? Adım Adım, Farzları ve Duaları"
  description="Abdest adım adım nasıl alınır? Abdestin 4 farzı, sünnetleri, abdesti bozan şeyler ve abdest duaları; Diyanet İslam İlmihali'ne dayanarak, sade bir dille."
  baslik="Abdest nasıl alınır?"
  ozet="Abdest, namazdan önce yüzü, kolları ve ayakları yıkayıp başı meshederek yapılan temizliktir. Namaz kılmak için abdest şarttır; abdestsiz kılınan namaz sahih olmaz."
  yol="abdest-nasil-alinir"
  yayin="2026-10-17"
  basliklar={basliklar}
  kaynaklar={kaynaklar}
>
  <h2 id="adim-adim">Adım adım abdest nasıl alınır?</h2>
  <ol class="adimlar">
    {
      adimlar.map((a, i) => (
        <li class:list={['adim reveal', { 'adim-farz': a.hukum === 'Farz' }]}>
          <span class="adim-no" aria-hidden="true">
            {i + 1}
          </span>
          <div>
            <div class="adim-ust">
              <h3>
                <span class="sr-only">{i + 1}. adım: </span>
                {a.baslik}
              </h3>
              <span class:list={['etiket', { 'etiket-farz': a.hukum === 'Farz', 'etiket-sunnet': a.hukum === 'Sünnet' }]}>
                {a.hukum}
              </span>
              {a.kez && <span class="etiket">{a.kez}</span>}
            </div>
            <p set:html={a.metin} />
          </div>
        </li>
      ))
    }
  </ol>
  <p class="not">
    Oruçluysanız ağzınıza ve burnunuza su verirken suyu boğazınıza kaçıracak kadar ileri götürmeyin.
  </p>

  <blockquote class="alinti reveal">
    <p>“Bir kimse güzelce abdest alırsa, tırnaklarının altına kadar vücudundan günahları dökülür.”</p>
    <footer>Hadis-i şerif · Müslim, Tahâre, 33</footer>
  </blockquote>
  <p class="kaynak-not">Kaynak: İslam İlmihali, s. 97, 102, 104–107; DİYK, “Abdest nedir ve nasıl alınır?”</p>

  <h2 id="farzlar">Abdestin farzları nelerdir?</h2>
  <p>
    Abdestin farzları dörttür ve Kur'an'da, Mâide suresinin 6. ayetinde açıkça sayılır. Organları birer kere yıkamak farz, üçer kere yıkamak sünnettir. Abdestte vacip yoktur.
  </p>
  <blockquote class="alinti reveal">
    <p>
      “Ey iman edenler, namaz kılmaya kalktığınız zaman yüzlerinizi, dirseklerinize kadar ellerinizi ve başlarınıza mesh edip topuklara kadar ayaklarınızı yıkayın.”
    </p>
    <footer>Mâide suresi, 5/6</footer>
  </blockquote>
  <ol class="farzlar">
    {
      farzlar.map((f, i) => (
        <li class="farz reveal" style={`--gecikme: ${i * 0.1}s`}>
          <span class="rakam" aria-hidden="true">
            {i + 1}
          </span>
          <h3>{f.baslik}</h3>
          <p>{f.metin}</p>
        </li>
      ))
    }
  </ol>
  <p class="not">
    <strong>Şâfiî mezhebinde</strong> abdestin farzları altıdır: bu dördüne ek olarak niyet etmek ve organları ayetteki sırayla yıkamak (tertip) de farzdır.
  </p>

  <h3>Suyun deriye ulaşması gerekir</h3>
  <p>
    Yıkanan organlarda suyun deriye ulaşmasını engelleyen hamur, mum gibi şeylerin giderilmesi gerekir. Su geçirmeyen bir tabaka oluşturan oje ve boya da aynı hükümdedir. Suyun geçmesine engel olmayan kına ise abdeste mani değildir.
  </p>
  <p class="kaynak-not">
    Kaynak: İslam İlmihali, s. 98–101 ve 18 no.lu dipnot; DİYK, “Mezhepler arasında abdestin farzları konusunda farklılık var mıdır?”
  </p>

  <h2 id="sunnetler">Abdestin sünnetleri</h2>
  <p>Sünnetler farz değildir; terk edilseler de abdest geçerli olur. Başlıcaları şunlardır:</p>
  <ul class="isaretli">
    {sunnetler.map((s) => <li>{s}</li>)}
  </ul>
  <p class="kaynak-not">Kaynak: İslam İlmihali, s. 101–104</p>

  <h2 id="bozan">Abdesti bozan ve bozmayan şeyler</h2>
  <p>Abdestli birinde aşağıdaki hâllerden biri olursa abdest bozulur. Yanında, sık karıştırılan ama abdesti bozmayan durumları bulabilirsiniz.</p>
  <div class="karsilastirma">
    <div class="kutu-bozar reveal">
      <h3>Abdesti bozar</h3>
      <ul class="kutu-liste">
        {bozanlar.map((b) => <li>{b}</li>)}
      </ul>
    </div>
    <div class="kutu-bozmaz reveal" style="--gecikme: 0.1s">
      <h3>Abdesti bozmaz</h3>
      <ul class="kutu-liste">
        {bozmayanlar.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </div>
  <p class="not">
    <strong>Şâfiî mezhebinde</strong> ön ve arka dışında vücudun bir yerinden akan kan ve irin abdesti bozmaz.
  </p>
  <p class="kaynak-not">Kaynak: İslam İlmihali, s. 110–111 ve 25 no.lu dipnot</p>

  <h2 id="mekruhlar">Abdestin mekruhları</h2>
  <ul class="isaretli">
    <li>Suyu israf etmek, bir organı üç kereden fazla yıkamak.</li>
    <li>Suyu çok az kullanmak, yağ sürer gibi yıkamak.</li>
    <li>Suyu yüze ve organlara sertçe çarpmak.</li>
    <li>İhtiyaç olmadıkça konuşmak.</li>
    <li>Bir özür yokken başkasından yardım istemek.</li>
    <li>Temiz olmayan bir yerde abdest almak.</li>
  </ul>
  <p>
    Peygamberimiz abdest alırken suyu bol kullanan Sa'd'a “Bu israf nedir?” diye sormuş; “Abdestte de israf olur mu?” sorusuna “Evet, bir akarsuyun kenarında olsan bile” cevabını vermiştir (İbn Mâce, Tahâre, 48).
  </p>
  <p class="kaynak-not">Kaynak: İslam İlmihali, s. 109–110</p>

  <h2 id="dualar">Abdest duaları</h2>
  <p>
    Abdest alırken her organda okunan dualar müstehaptır: okunmasa da abdest tamamdır, ama bilen için okuması güzeldir.
  </p>
  <ul class="dualar">
    {
      dualar.map((dua) => (
        <li class="dua reveal">
          <span class="etiket etiket-sunnet">{dua.ne}</span>
          <p class="okunus">{dua.okunus}</p>
          <p class="anlam">“{dua.anlam}”</p>
        </li>
      ))
    }
  </ul>
  <p class="kaynak-not">Kaynak: İslam İlmihali, s. 107–109</p>

  <h2 id="sorular">Sık sorulan sorular</h2>
  <div class="sss">
    {
      sorular.map((s, i) => (
        <details open={i === 0}>
          <summary>{s.soru}</summary>
          <p>
            <Fragment set:html={s.cevap} /> <span class="kaynak-not">({s.kaynak})</span>
          </p>
        </details>
      ))
    }
  </div>
</Rehber>
