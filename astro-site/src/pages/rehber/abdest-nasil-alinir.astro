  },
  {
    baslik: 'Yüz',
    hukum: 'Farz',
    kez: '3 kere',
    cizim: 'yuz',
    metin:
      'Alnınızın üstünde saçın bittiği yerden başlayarak çene altına ve iki kulak yumuşağına kadar yüzünüzün her yerini yıkayın. Sakalınız varsa parmaklarınızla aralayın; seyrekse suyun deriye ulaşmasını sağlayın.',
  },
  {
    baslik: 'Kollar',
    hukum: 'Farz',
    kez: '3 kere',
    cizim: 'kollar',
    metin:
      'Önce sağ kolunuzu, sonra sol kolunuzu parmak uçlarından başlayarak dirseklerle beraber yıkayın. Dirsekler yıkanacak yere dahildir; suyun dirseklerin her tarafına ulaştığından emin olun.',
  },
  {
    baslik: 'Baş',
    hukum: 'Farz',
    kez: 'mesh',
    cizim: 'bas',
    metin:
      'Ellerinizi ıslatın ve sağ elinizin içiyle başınızın <strong>en az dörtte birini</strong> meshedin; farz böylece yerine gelir. Meshedilecek yer, iki kulağın üst tarafında kalan kısımdır; kulaklardan aşağı sarkan saçlar meshedilmez.\n\nBaşın tamamını meshetmek sünnettir ve şöyle yapılır: Islak iki elinizin parmak uçlarını birleştirin. Başparmaklarınızı ve şehadet parmaklarınızı kaldırın, kalan üçer parmağınızı başınızın ön tarafına koyun ve enseye kadar sıvazlayın. Başa değdirmediğiniz şehadet parmakları ve başparmaklar, sıradaki adımda kulaklar için kullanılır.',
  },
  {
    baslik: 'Kulaklar',
    hukum: 'Sünnet',
    kez: 'mesh',
    cizim: 'kulaklar',
    metin:
      'Şehadet parmaklarınızla kulaklarınızın içini, başparmaklarınızla dışını meshedin. Ellerinizde ıslaklık kalmadıysa önce yeniden ıslatın.',
  },
  {
    baslik: 'Boyun',
    hukum: 'Sünnet',
    kez: 'mesh',
    cizim: 'boyun',
    metin: 'Yeni su almadan, iki elinizin arkasıyla boynunuzu meshedin.',
  },
  {
    baslik: 'Ayaklar',
    hukum: 'Farz',
    kez: '3 kere',
    cizim: 'ayaklar',
    metin:
      'Önce sağ, sonra sol ayağınızı topuklarla beraber yıkayın. Parmak uçlarından başlayın; parmak aralarını sağ ayağın küçük parmağından başlayıp sol ayağın küçük parmağında bitirecek şekilde temizleyin.',
  },
  {
    baslik: 'Kelime-i şehadet',
    hukum: 'Edep',
    cizim: 'sehadet',
    metin: 'Abdest bitince kıbleye dönüp kelime-i şehadet getirin.',
  },
];

const farzlar: { baslik: string; cizim: Farz; metin: string }[] = [
  {
    baslik: 'Yüzü bir kere yıkamak',
    cizim: 'yuz',
    metin:
      'Yüz; alında saçın bittiği yerden çene altına, iki kulak yumuşağı arasına kadar olan yerdir. Kirpikler ve göz pınarları da yıkanır, gözün içi yıkanmaz. Sık sakalın yalnız üstünü yıkamak yeterlidir.',
  },
  {
    baslik: 'Kolları dirseklerle beraber bir kere yıkamak',
    cizim: 'kollar',
    metin: 'Eller ve kollar, dirsekler de dahil olmak üzere yıkanır; dirseklerin yukarısını yıkamak gerekmez.',
  },
  {
    baslik: 'Başın dörtte birini meshetmek',
    cizim: 'bas',
    metin:
      'Mesh, ıslak eli değdirmektir. Kolları yıkadıktan sonra elde kalan suyla mesh olmaz; başı meshetmek için yeni su alınır.',
  },
  {
    baslik: 'Ayakları topuklarla beraber bir kere yıkamak',
    cizim: 'ayaklar',
    metin: 'Topuklar da yıkanır. Çıplak ayağa mesh etmek caiz değildir.',
  },
];

const sunnetler = [
  'Abdeste başlarken elleri bileklere kadar yıkamak.',
  'Eûzü ve Besmele ile başlamak.',
  'Niyet etmek. Niyet kalple olur; dille söylemek müstehaptır.',
  'Dişleri misvak veya fırçayla, bunlar yoksa parmakla temizlemek.',
  'Ağza üç kere su alıp çalkalamak (mazmaza) ve buruna üç kere su çekmek (istinşak).',
  'Ayetteki sıraya uymak: önce yüz, sonra kollar, sonra baş, en son ayaklar.',
  'Kolları ve ayakları yıkarken sağdan başlamak.',
  'Her organı üç kere yıkamak (ilki farz, diğer ikisi sünnettir).',
  'Elleri ve ayakları yıkamaya parmak uçlarından başlamak ve parmak aralarını ovmak.',
  'Sık sakalı parmaklarla aşağıdan yukarıya doğru aralamak.',
  'Başın tamamını meshetmek, kulakları ve boynu meshetmek.',
  'Organları iyice ovarak yıkamak.',
  'Organları ara vermeden, biri kurumadan diğerine geçerek yıkamak.',
];

const bozanlar = [
  'Ön ve arkadan idrar, dışkı gibi bir şey çıkması ve arkadan yel çıkması.',
  'Vücudun herhangi bir yerinden kan veya irin akması. Ağızdan gelen kan tükürükle eşit ya da ondan fazlaysa bozar, azsa bozmaz; bu, tükürüğün renginden anlaşılır.',
  'Ağız dolusu kusmak.',
  'Yatarak ya da namaz dışında secdedeymiş gibi durarak uyumak; bir şeye dayanarak uyurken, dayanılan şey çekildiğinde düşecek hâlde olmak.',
  'Bayılmak.',
  'Akıl hastalığı sebebiyle aklın gitmesi.',
  'Sarhoş olmak.',
  'Namazda yanındakinin duyacağı kadar sesli gülmek. Bu hem namazı hem abdesti bozar. Yalnız kendi duyacağı kadar gülmek abdesti bozmaz ama namazı bozar; gülümsemek ikisini de bozmaz. Cenaze namazında ve tilavet secdesinde sesli gülmek abdesti bozmaz, yalnızca o namazı veya secdeyi bozar. Ergenlik çağına girmemiş çocuğun namazda gülmesiyle de yalnızca namazı bozulur.',
  'Eşlerin tenasül organlarının birbirine değmesi (fahiş mübaşeret). Hiçbir ıslaklık gelmese de abdest bozulur; arada vücut sıcaklığının hissedilmesine engel olmayan ince bir şey bulunsa bile yine bozulur.',
];

const bozmayanlar = [
  'Çıktığı yerde kalıp etrafa yayılmayan kan.',
  'Ağız dolusundan az kusmak ve balgam tükürmek.',
  'Diş fırçasında, kürdanda ya da ısırılan bir şeyde görülen ama akmayan kan.',
  'Hastalık sebebiyle olmayan, ağlamaktan veya gülmekten akan göz yaşı.',
  'Yere sağlam oturmuş, eklemleri gevşememiş hâlde uyumak: bağdaş kurarak, dizüstü ya da araçta koltuğa yaslanmadan dik oturarak uyumak. Namazda uyumak da bozmaz. Ancak bu hâllerde yel çıkması gibi abdesti bozan bir şey olduğu biliniyorsa abdest bozulur.',
];

const dualar = [
  {
    ne: 'Abdeste başlarken',
    okunus: 'El-hamdü lillâhillezî ce’ale’l-mâe tahûren ve ce’ale’l-islâme nûrâ.',
    anlam: "Suyu temizleyici ve İslam'ı nur kılan Allah'a hamdolsun.",
  },
  {
    ne: 'Ağza su alırken',
    okunus: 'Allâhümme’skınî min havzi nebiyyike ke’sen lâ ezmeu ba’dehu ebedâ.',
    anlam: 'Allahım! Bana peygamberin havuzundan öyle bir kâse içir ki ondan sonra bir daha susamayayım.',
  },
  {
    ne: 'Buruna su alırken',
    okunus: 'Allâhümme lâ tahrimnî râihate naîmike ve cennâtik.',
    anlam: 'Allahım! Beni nimetlerinin ve cennetlerinin kokusundan mahrum etme.',
  },
  {
    ne: 'Yüzü yıkarken',
    okunus: 'Allâhümme beyyid vechî binûrike yevme tebyeddu vücûhun ve tesveddu vücûh.',
    anlam: 'Allahım! Bazı yüzlerin beyazlanacağı bazı yüzlerin de kararacağı günde benim yüzümü ak eyle.',
  },
  {
    ne: 'Sağ kolu yıkarken',
    okunus: 'Allâhümme a’tinî kitabî biyeminî ve hâsibnî hisâben yesîrâ.',
