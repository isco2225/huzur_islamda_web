---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { rehberler } from '../../data/rehberler';

// Rehber dizini: liste src/data/rehberler.ts'ten gelir.
const title = 'İbadet Rehberi: Abdest, Namaz ve Mübarek Geceler | İbadet Rehberim';
const description =
  'Abdest, namaz ve mübarek gecelerle ilgili temel bilgiler adım adım. Diyanet İşleri Başkanlığı kaynaklarına dayanan, sade ve kaynaklı rehberler.';

const kirinti = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Rehber' },
  ],
};
---

<Base title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(kirinti)} />
  <main>
    <section class="kapsayici pt-[clamp(3rem,8vw,5.5rem)] pb-[clamp(3rem,8vw,5rem)]">
      <p class="eyebrow">Rehber</p>
      <h1 class="mt-6 max-w-[20ch]">İbadetin temel bilgileri, adım adım</h1>
      <p class="mt-5 max-w-[56ch] text-[1.125rem] leading-[1.7] text-soluk">
        Abdestten kandil gecelerine, temel ibadet bilgilerini sade bir dille anlatıyoruz. Her rehber Diyanet
        İşleri Başkanlığı kaynaklarına dayanır ve kaynaklarını sayfanın sonunda gösterir.
      </p>

      <ul class="mt-12 grid gap-5 md:grid-cols-2">
        {
          rehberler.map((r) => (
            <li>
              <a
                href={`/rehber/${r.yol}/`}
                class="cizgi golge block h-full rounded-[20px] border bg-yuzey p-6 transition-transform duration-200 hover:-translate-y-px"
              >
                <h2 class="text-[1.35rem]">{r.kisaAd}</h2>
                <p class="mt-2 leading-[1.7] text-soluk">{r.ozet}</p>
                <span class="mt-4 inline-block font-medium text-vurgu-koyu">Rehberi oku →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <FinalCTA />
  </main>
  <Footer />
</Base>
