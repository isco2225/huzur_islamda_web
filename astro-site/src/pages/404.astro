---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

// GitHub Pages kökteki 404.html'i otomatik servis eder; Astro 404.astro'yu
// tam oraya üretir. Sitemap bu sayfayı kendiliğinden dışarıda bırakır.
const title = 'Sayfa Bulunamadı | İbadet Rehberim';
const description =
  'Aradığınız sayfa bulunamadı. İbadet Rehberim ana sayfasından devam edebilirsiniz.';
---

<Base title={title} description={description}>
  <meta slot="head" name="robots" content="noindex" />
  <main class="kapsayici flex flex-col items-center py-[clamp(4rem,12vw,8rem)] text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-5 text-[clamp(2rem,4vw,2.6rem)]">Sayfa bulunamadı</h1>
    <p class="mt-4 max-w-[44ch] leading-[1.7] text-soluk">
      Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Ana sayfadan devam
      edebilirsiniz.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-[48px] items-center rounded-full bg-murekkep px-6 font-medium text-zemin transition-all duration-200 hover:-translate-y-px hover:bg-vurgu-koyu"
    >
      Ana sayfaya dön
    </a>
  </main>
  <Footer />
</Base>
