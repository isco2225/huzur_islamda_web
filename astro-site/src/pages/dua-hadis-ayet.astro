---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import FinalCTA from '../components/FinalCTA.astro';
import MagazaButonlari from '../components/MagazaButonlari.astro';
import GeriDon from '../components/GeriDon.astro';
import kartKesfet from '../assets/gorseller/kart-kesfet.png';
import kartGonderi from '../assets/gorseller/kart-gonderi.png';

// İçerik kaynağı: UYGULAMA_OZELLIKLERI.md §4 (Akış), §5 (gönderi bağlamında
// asistan) ve §10 (kaydedilen gönderiler). Yalnız belgelenmiş davranışlar anlatılır.
const title = 'Dua, Hadis ve Ayet Akışı | İbadet Rehberim';
const description =
  "Dualar, hadisler ve Kur'an ayetleri tek akışta: Arapça aslı ve Türkçe açıklamasıyla okuyun, beğendiklerinizi kaydedin, merak ettiğinizi asistana sorun. Ücretsiz.";

const maddeler = [
  {
    baslik: 'Üç içerik türü, tek akış',
    metin:
      "Dua, hadis ve Kur'an ayetleri aynı akışta gelir; her kart türünü gösteren etiketiyle ayrılır. Aşağı kaydırdıkça yeni gönderiler yüklenir, akış kaldığınız yerden devam eder.",
  },
  {
    baslik: 'Arapça aslı, Türkçe açıklaması',
    metin:
      'Kartlarda başlık, varsa sağdan sola Arapça metin ve Türkçe açıklama bir arada durur. Karta dokununca içeriğin tamamının yer aldığı detay sayfası açılır.',
  },
  {
    baslik: 'Kaydedin, sonra dönün',
    metin:
      'Beğendiğiniz gönderiyi kaydedersiniz; kaydettikleriniz ayrı bir listede toplanır. Sonra dönüp tekrar okumak için akışta aramanıza gerek kalmaz.',
  },
];

const kirinti = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Dua, Hadis ve Ayetler' },
  ],
};
---

<Base title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(kirinti)} />
  <main>
    <section class="kapsayici pt-[clamp(3rem,8vw,5.5rem)] pb-[clamp(2.5rem,6vw,4rem)]">
      <div class="grid items-center gap-12 lg:grid-cols-[7fr_5fr] lg:gap-8">
        <div class="max-w-[560px]">
          <div class="giris-1"><GeriDon /></div>
          <p class="giris-1 eyebrow mt-4">Dua, hadis ve ayetler</p>
          <h1 class="giris-2 mt-6">
            Dua, hadis ve ayetler <span class="text-vurgu-koyu">tek akışta</span>
          </h1>
          <p class="giris-3 mt-5 max-w-[46ch] text-[1.125rem] leading-[1.7] text-soluk">
            Akışı açın, okuyun: dualar, hadisler ve Kur'an ayetleri Arapça aslı ve
            Türkçe açıklamasıyla karşınızda. Beğendiklerinizi kaydeder, dilediğinizde
            geri dönersiniz.
          </p>
          <div class="giris-4 mt-8">
            <MagazaButonlari />
          </div>
        </div>

        <!-- Çerçeve, köşe ve gölge görselin içindedir (GORSELLER.md §3) -->
        <div class="giris-4">
          <Image
            src={kartKesfet}
            alt="Keşfet akışı: hadis ve dua kartları"
            width={420}
            densities={[1, 2]}
            class="mx-auto h-auto w-[min(85%,420px)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section class="bolum cizgi border-y bg-yuzey">
      <div class="kapsayici">
        <h2 class="reveal max-w-[24ch]">Akışta sizi ne karşılar?</h2>
        <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
          {
            maddeler.map((madde, i) => (
              <li class="reveal cizgi border-t pt-6" style={`--gecikme: ${0.1 + i * 0.12}s`}>
                <h3 class="text-[1.35rem]">{madde.baslik}</h3>
                <p class="mt-3 leading-[1.7] text-soluk">{madde.metin}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bolum kapsayici">
      <div class="grid items-center gap-12 lg:grid-cols-[5fr_7fr] lg:gap-8">
        <div class="order-2 lg:order-1">
          <Image
            src={kartGonderi}
            alt="Gönderi detayı: Arapça metniyle birlikte bir dua ve Türkçe açıklaması"
            width={420}
            densities={[1, 2]}
            class="reveal mx-auto h-auto w-[min(85%,420px)]"
            loading="lazy"
          />
        </div>
        <div class="order-1 max-w-[560px] lg:order-2">
          <h2 class="reveal max-w-[24ch]">Okuduğunuz yerden asistana sorun</h2>
          <p class="reveal mt-5 max-w-[52ch] leading-[1.7] text-soluk" style="--gecikme: 0.1s">
            Bir dua ya da hadis aklınıza soru mu getirdi? Gönderi detayından asistan
            sohbetine geçersiniz; asistan o gönderiyi bilir ve sorularınıza aynı
            bağlamda cevap verir.
          </p>
          <p class="reveal mt-4 max-w-[52ch] leading-[1.7] text-soluk" style="--gecikme: 0.2s">
            Günlük ibadet rutininiz için
            <a href="/namaz-vakitleri/" class="text-vurgu-koyu underline">namaz vakitleri</a>
            ve
            <a href="/zikirmatik/" class="text-vurgu-koyu underline">akıllı zikirmatik</a>
            özelliklerine bakabilir, merak ettikleriniz için
            <a href="/#sss" class="text-vurgu-koyu underline">sıkça sorulan sorulara</a>
            göz atabilirsiniz.
          </p>
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>
  <Footer />
</Base>
