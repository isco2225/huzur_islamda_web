---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import VakitKusagi from '../components/VakitKusagi.astro';
import NasilCalisir from '../components/NasilCalisir.astro';
import Ozellikler from '../components/Ozellikler.astro';
import EkranSeridi from '../components/EkranSeridi.astro';
import SSS from '../components/SSS.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { playStoreUrl } from '../components/MagazaButonlari.astro';
import { faq } from '../components/SSS.astro';

const title = 'İbadet Rehberim — Namaz Vakitleri, Zikirmatik ve Dua';
const description =
  "Kur'an ve sünnet ışığında namaz vakitleri, akıllı zikirmatik, dua-hadis-Kur'an içerikleri ve İslami asistan. İbadet Rehberim'i ücretsiz indirin.";

// Yalnızca doğrulanmış bilgiler; App Store linki henüz yok (uygulama yalnızca Google Play'de).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'İbadet Rehberim',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'LifestyleApplication',
  description,
  image: new URL('/og.png', Astro.site).href,
  installUrl: playStoreUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
};

// SSS bölümündeki gerçek soru-cevaplardan FAQPage şeması (kaynak: SSS.astro)
const sssSema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((soru) => ({
    '@type': 'Question',
    name: soru.question,
    acceptedAnswer: { '@type': 'Answer', text: soru.answer },
  })),
};
---

<Base title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(sssSema)} />
  <main>
    <Hero />
    <VakitKusagi />
    <NasilCalisir />
    <Ozellikler />
    <EkranSeridi />
    <SSS />
    <FinalCTA />
  </main>
  <Footer />
</Base>
