---
import { Image } from 'astro:assets';
import kartVakitler from '../assets/gorseller/kart-vakitler.png';
import kartZikirSayac from '../assets/gorseller/kart-zikir-sayac.png';
import kartAsistan from '../assets/gorseller/kart-asistan.png';
import kartZikirlerim from '../assets/gorseller/kart-zikirlerim.png';
import kartKesfet from '../assets/gorseller/kart-kesfet.png';
import kartGonderi from '../assets/gorseller/kart-gonderi.png';

// Küratörlü 6 kart — sıra ve alt metinler GORSELLER.md'den.
// Köşe yuvarlaklığı ve gölge görselin İÇİNDEDİR; site tarafında eklenmez.
const ekranlar = [
  {
    resim: kartVakitler,
    alt: 'İbadet Rehberim ezan vakitleri ekranı: günün altı vakti ve sonraki vakte kalan süre',
    altYazi: 'Ezan vakitleri',
  },
  {
    resim: kartZikirSayac,
    alt: 'Zikirmatik ekranı: Sübhanallah zikrinde 50/100 ilerleme halkası',
    altYazi: 'Zikirmatik',
  },
  {
    resim: kartAsistan,
    alt: 'Yapay zekâ asistan ekranı: dua, hadis ve İslami sorular için sohbet',
    altYazi: 'İslami asistan',
  },
  {
    resim: kartZikirlerim,
    alt: 'Zikirlerim ekranı: günlük zikir hedefleri ve ilerleme çubukları',
    altYazi: 'Günlük zikir takibi',
  },
  {
    resim: kartKesfet,
    alt: 'Keşfet akışı: hadis ve dua kartları',
    altYazi: 'Keşfet akışı',
  },
  {
    resim: kartGonderi,
    alt: 'Gönderi detayı: Arapça metniyle birlikte bir dua ve Türkçe açıklaması',
    altYazi: 'Gönderi detayı',
  },
];
---

<section id="ekranlar" class="bolum">
  <div class="kapsayici">
    <p class="eyebrow reveal">Ekranlar</p>
    <h2 class="reveal mt-3 max-w-[26ch]" style="--gecikme: 0.08s">
      Uygulamanın içinden birkaç ekran
    </h2>
  </div>

  <div class="serit-dis">
    <ul class="serit reveal-grup" aria-label="Uygulama ekran görüntüleri">
      {
        ekranlar.map((ekran) => (
          <li class="kare">
            <figure>
              <Image
                src={ekran.resim}
                alt={ekran.alt}
                width={380}
                densities={[1, 2]}
                class="resim"
                loading="lazy"
              />
              <figcaption>{ekran.altYazi}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Mobilde kenardan kenara, masaüstünde konteynerle hizalı şerit — TASARIM.md §8 */
  .serit-dis {
    margin-top: 3rem;
  }
  .serit {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: 0.5rem;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    scroll-padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }
  @media (min-width: 1200px) {
    .serit {
      padding-inline: calc((100vw - 1120px) / 2 + 2.5rem);
      scroll-padding-inline: calc((100vw - 1120px) / 2 + 2.5rem);
    }
  }

  .kare {
    flex-shrink: 0;
    scroll-snap-align: start;
    width: min(78vw, 380px);
  }
  .resim {
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-soluk);
  }
</style>
