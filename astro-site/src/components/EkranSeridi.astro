---
import { Image } from 'astro:assets';

// Mağaza tanıtım görselleri (gorseller/store_photos): koyu yeşil zeminli,
// başlıklı 8 kare. Tam kanvas oldukları için köşe ve gölge site tarafında verilir.
const dosyalar = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gorseller/store/*.png',
  { eager: true }
);
const altYazilar: Record<string, { alt: string; altYazi: string }> = {
  '01-vakitler': {
    alt: 'Mağaza görseli — Hiçbir vakti kaçırma: konuma göre ezan vakitleri listesi ve kalan süre',
    altYazi: 'Ezan vakitleri',
  },
  '02-zikir-sayac': {
    alt: 'Mağaza görseli — zikirmatik sayaç ekranı',
    altYazi: 'Zikirmatik',
  },
  '03-zikir-tesbihat': {
    alt: 'Mağaza görseli — namaz tesbihatını tek dokunuşla oluşturma',
    altYazi: 'Namaz tesbihatı',
  },
  '04-zikirlerim': {
    alt: 'Mağaza görseli — günlük zikir hedefleri ve ilerleme listesi',
    altYazi: 'Günlük zikir takibi',
  },
  '05-asistan': {
    alt: 'Mağaza görseli — İslami sorular için asistan sohbeti',
    altYazi: 'İslami asistan',
  },
  '06-kesfet': {
    alt: 'Mağaza görseli — dua ve hadis kartlarından oluşan keşfet akışı',
    altYazi: 'Keşfet akışı',
  },
  '07-gonderi': {
    alt: 'Mağaza görseli — Arapça metniyle birlikte gönderi detayı',
    altYazi: 'Gönderi detayı',
  },
  '08-kapanis': {
    alt: 'Mağaza görseli — İbadet Rehberim: ibadetin ritmi, cebinde',
    altYazi: 'İbadet Rehberim',
  },
};
const ekranlar = Object.keys(dosyalar)
  .sort()
  .map((yol) => {
    const ad = yol.split('/').pop()!.replace('.png', '');
    return { resim: dosyalar[yol].default, ...altYazilar[ad] };
  });
---

<!-- Beyaz bant: koyu yeşil mağaza görselleri burada öne çıkar -->
<section id="ekranlar" class="bolum cizgi border-y bg-yuzey">
  <div class="kapsayici">
    <p class="eyebrow reveal">Ekranlar</p>
    <h2 class="reveal mt-4 max-w-[26ch]" style="--gecikme: 0.08s">
      Uygulamanın içinden birkaç ekran
    </h2>
  </div>

  <div class="serit-dis">
    <ul class="serit reveal-grup" aria-label="Uygulama ekran görüntüleri">
      {
        ekranlar.map((ekran) => (
          <li class="kare">
            <figure>
              <Image
                src={ekran.resim}
                alt={ekran.alt}
                width={300}
                densities={[1, 2]}
                class="resim"
                loading="lazy"
              />
              <figcaption>{ekran.altYazi}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Mobilde kenardan kenara, masaüstünde konteynerle hizalı şerit — TASARIM.md §8 */
  .serit-dis {
    margin-top: 3rem;
  }
  .serit {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: 0.5rem;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    scroll-padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }
  @media (min-width: 1200px) {
    .serit {
      padding-inline: calc((100vw - 1120px) / 2 + 2.5rem);
      scroll-padding-inline: calc((100vw - 1120px) / 2 + 2.5rem);
    }
  }

  .kare {
    flex-shrink: 0;
    scroll-snap-align: start;
    width: min(68vw, 280px);
  }
  /* Görseller tam kanvas: köşe ve tek hafif gölge site tarafında */
  .resim {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow:
      0 1px 2px rgb(32 34 26 / 6%),
      0 16px 32px -20px rgb(32 34 26 / 20%);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-soluk);
  }
</style>
