---
import { Image } from 'astro:assets';

// 9 gerçek ekran görüntüsü + görüntülerdeki gerçek başlıklardan türetilen alt yazılar
const dosyalar = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screenshots/screenshot-*.jpg',
  { eager: true }
);
const altYazilar = [
  'Genel görünüm',
  'Keşfet akışı: günün ayet ve hadisleri',
  'Namaz vakitleri ve bildirimler',
  'İslami asistan',
  'Zikir oluşturma seçenekleri',
  'Ruh haline göre zikirler',
  'Zikirmatik',
  'Günlük zikir takibi',
  'Namaz tesbihatı',
];
const ekranlar = Object.keys(dosyalar)
  .sort((a, b) =>
    a.localeCompare(b, undefined, { numeric: true })
  )
  .map((yol, i) => ({ resim: dosyalar[yol].default, altYazi: altYazilar[i] ?? '' }));
---

<section id="ekranlar" class="bolum reveal">
  <div class="kapsayici">
    <p class="eyebrow">Ekranlar</p>
    <h2 class="mt-3 max-w-[26ch]">Uygulamanın içinden birkaç ekran</h2>
  </div>

  <div class="serit-dis">
    <ul class="serit" aria-label="Uygulama ekran görüntüleri">
      {
        ekranlar.map((ekran, i) => (
          <li class="kare">
            <figure>
              <Image
                src={ekran.resim}
                alt={`İbadet Rehberim — ${ekran.altYazi}`}
                width={440}
                densities={[1, 2]}
                class="resim"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
              <figcaption>{ekran.altYazi}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Mobilde kenardan kenara, masaüstünde konteynerle hizalı şerit — TASARIM.md §8 */
  .serit-dis {
    margin-top: 3rem;
  }
  .serit {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: 0.5rem;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    scroll-padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }
  @media (min-width: 1200px) {
    .serit {
      padding-inline: calc((100vw - 1120px) / 2 + 2.5rem);
      scroll-padding-inline: calc((100vw - 1120px) / 2 + 2.5rem);
    }
  }

  .kare {
    flex-shrink: 0;
    scroll-snap-align: start;
    width: min(62vw, 220px);
  }
  .resim {
    width: 100%;
    height: auto;
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--color-detay) 25%, transparent);
    background: var(--color-yuzey);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-soluk);
  }
</style>
