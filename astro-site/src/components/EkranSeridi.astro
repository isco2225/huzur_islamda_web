---
import { Image } from 'astro:assets';

// Mağaza tanıtım görselleri (gorseller/store_photos = App Store seti,
// 1242×2688): başlıklı, krem/yeşil zeminli 6 kare. Şeritteki sıra dosya
// adındaki numaradır; mağazadaki sıradan farklı olarak ezan vakitleri başta.
// Tam kanvas oldukları için köşe, çerçeve ve gölge site tarafında verilir.
const dosyalar = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gorseller/store/*.png',
  { eager: true }
);
const altYazilar: Record<string, { alt: string; altYazi: string }> = {
  '01-vakitler': {
    alt: 'Mağaza görseli — Ezan vaktini kaçırma: şehre göre ezan vakitleri, vakit bildirimi ve kalan süre',
    altYazi: 'Ezan vakitleri',
  },
  '02-vitrin': {
    alt: 'Mağaza görseli — İbadet Rehberim: keşfet akışında hadis ve ayet kartları, sonraki vakit ve günlük zikir bildirimleri',
    altYazi: 'İbadet Rehberim',
  },
  '03-kesfet': {
    alt: 'Mağaza görseli — Okurken sor, anında öğren: Arapça metniyle gönderi detayı ve asistan düğmesi',
    altYazi: 'Okurken sor',
  },
  '04-asistan': {
    alt: 'Mağaza görseli — Merak ettiklerini çekinmeden sor: dualar hakkında asistan sohbeti',
    altYazi: 'İslami asistan',
  },
  '05-zikir-onerileri': {
    alt: 'Mağaza görseli — Kalbine göre zikirler: günlük zikir listesi, ruh haline göre ve namaz için zikir seçenekleri',
    altYazi: 'Zikir önerileri',
  },
  '06-zikirmatik': {
    alt: 'Mağaza görseli — Zikirlerini dokunuşla say: hedefli zikirmatik sayacı',
    altYazi: 'Zikirmatik',
  },
};
const ekranlar = Object.keys(dosyalar)
  .sort()
  .map((yol) => {
    const ad = yol.split('/').pop()!.replace('.png', '');
    return { resim: dosyalar[yol].default, ...altYazilar[ad] };
  });
---

<!-- Beyaz bant: krem/yeşil mağaza görselleri burada öne çıkar -->
<section id="ekranlar" class="bolum cizgi border-y bg-yuzey">
  <div class="kapsayici">
    <p class="eyebrow reveal">Ekranlar</p>
    <h2 class="reveal mt-4 max-w-[26ch]" style="--gecikme: 0.08s">
      Uygulamanın içinden birkaç ekran
    </h2>
  </div>

  <div class="serit-dis">
    <ul class="serit reveal-grup" aria-label="Uygulama ekran görüntüleri">
      {
        ekranlar.map((ekran) => (
          <li class="kare">
            <figure>
              <Image
                src={ekran.resim}
                alt={ekran.alt}
                width={220}
                densities={[1, 2]}
                class="resim"
                loading="lazy"
              />
              <figcaption>{ekran.altYazi}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Mobilde kenardan kenara, masaüstünde konteynerle hizalı şerit — TASARIM.md §8 */
  .serit-dis {
    margin-top: 3rem;
  }
  .serit {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: 0.5rem;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    scroll-padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }
  @media (min-width: 1200px) {
    .serit {
      padding-inline: calc((100vw - 1120px) / 2 + 2.5rem);
      scroll-padding-inline: calc((100vw - 1120px) / 2 + 2.5rem);
    }
  }

  .kare {
    flex-shrink: 0;
    scroll-snap-align: start;
    width: min(56vw, 220px);
  }
  /* Görseller tam kanvas: köşe, kıl çizgisi ve tek hafif gölge site
     tarafında. Çizgi krem görselin beyaz bantta kenarını belli eder. */
  .resim {
    width: 100%;
    height: auto;
    border-radius: 20px;
    outline: 1px solid color-mix(in srgb, var(--color-detay) 20%, transparent);
    outline-offset: -1px;
    box-shadow:
      0 1px 2px rgb(32 34 26 / 6%),
      0 16px 32px -20px rgb(32 34 26 / 20%);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-soluk);
  }
</style>
