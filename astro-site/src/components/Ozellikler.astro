---

<section class="bg-surface/50">
  <div class="mx-auto max-w-[1200px] px-5 py-12 md:px-12 md:py-16 lg:py-20">
    <h2 class="text-center text-[26px] font-bold text-primary md:text-[28px] xl:text-[32px]">
      Neden İbadet Rehberim?
    </h2>
    <div class="mt-7 grid gap-5 md:mt-10 md:grid-cols-2 md:gap-6 xl:mt-12 xl:gap-8">
      {
        features.map((feature) => (
          <article class="rounded-2xl border border-primary bg-cream p-6 xl:p-7">
            <svg viewBox="0 0 24 24" class="h-10 w-10 fill-primary xl:h-11 xl:w-11" aria-hidden="true">
              <path d={feature.icon} />
            </svg>
            <h3 class="mt-4 font-semibold text-primary xl:mt-5 xl:text-[17px]">{feature.title}</h3>
            <p class="mt-2 text-[15px] leading-[1.45] text-ink">{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
