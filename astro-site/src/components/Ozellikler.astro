---
/*
 * Özellik kartları — TASARIM.md §6.4: fiil öncelikli başlık + kartın içinde
 * HTML/CSS mini demo. Demo içerikleri gerçek uygulama ekranlarından.
 * İstisna (GORSELLER.md §2.6): zikir özelliği mini demo yerine bölüm sonundaki
 * hazır akış bandıyla anlatılır. İkonlar: tek set inline SVG (Lucide çizgi stili).
 */
import { Image } from 'astro:assets';
import akisZikir from '../assets/gorseller/akis-zikir.png';
---

<section id="ozellikler" class="bolum kapsayici">
  <p class="eyebrow reveal">Özellikler</p>
  <h2 class="reveal mt-4 max-w-[24ch]" style="--gecikme: 0.08s">Uygulamada neler var?</h2>

  <div class="mt-12 grid gap-6 md:grid-cols-2 xl:gap-8">
    <!-- Namaz vakitleri -->
    <article class="kart reveal" style="--gecikme: 0.1s">
      <svg class="ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <h3>Vaktini bil</h3>
      <p>
        Altı vakit ilçenize göre listelenir. Hangi vakitte olduğunuzu ve bir sonrakine ne
        kadar kaldığını tek bakışta görürsünüz. Ayrıntısı
        <a href="/namaz-vakitleri/" class="text-vurgu-koyu underline">namaz vakitleri sayfasında</a>.
      </p>
      <div class="demo rakam" aria-hidden="true">
        <div class="demo-satir vurgulu">
          <span>Öğle</span>
          <span>13:23</span>
        </div>
        <div class="demo-satir">
          <span>Kalan süre</span>
          <span class="yesil">1 sa 45 dk</span>
        </div>
      </div>
    </article>

    <!-- Zikirmatik -->
    <article class="kart reveal" style="--gecikme: 0.2s">
      <svg class="ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m17 2 4 4-4 4"></path>
        <path d="M3 11v-1a4 4 0 0 1 4-4h14"></path>
        <path d="m7 22-4-4 4-4"></path>
        <path d="M21 13v1a4 4 0 0 1-4 4H3"></path>
      </svg>
      <h3>Zikrini say</h3>
      <p>
        Kendi zikrinizi oluşturabilir, namaz tesbihatını tek dokunuşla kurabilir ya da ruh
        halinize uygun hazır setleri kullanabilirsiniz. Nasıl işlediği aşağıda; ayrıntısı
        <a href="/zikirmatik/" class="text-vurgu-koyu underline">zikirmatik sayfasında</a>.
      </p>
    </article>

    <!-- Dua-hadis-Kur'an akışı -->
    <article class="kart reveal" style="--gecikme: 0.3s">
      <svg class="ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
      <h3>Dua ve hadis oku</h3>
      <p>
        Dualar, hadisler ve ayetler tek bir akışta gelir. Beğendiklerinizi kaydeder, sonra
        dönüp tekrar okursunuz. Ayrıntısı
        <a href="/dua-hadis-ayet/" class="text-vurgu-koyu underline">dua, hadis ve ayetler sayfasında</a>.
      </p>
      <div class="demo" aria-hidden="true">
        <div class="demo-satir">
          <span class="etiket">dua</span>
          <svg class="demo-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
          </svg>
        </div>
        <p class="demo-metin">İşlerin Kolaylaşması İçin Dua</p>
      </div>
    </article>

    <!-- Asistan -->
    <article class="kart reveal" style="--gecikme: 0.4s">
      <svg class="ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
      </svg>
      <h3>Asistana sor</h3>
      <p>
        İslami konularda merak ettiğiniz bir şeyi asistana sorabilirsiniz. Okuduğunuz bir
        duadan ya da hadisten sohbete devam etmek de mümkün.
      </p>
      <div class="demo" aria-hidden="true">
        <p class="balon">Merhaba, ben senin asistanınım.</p>
        <p class="balon soru">Tesbih için bir zikir önerir misin?</p>
      </div>
    </article>
  </div>

  <!-- Zikir akışı bandı: menü → tesbihat onayı → liste → sayaç (GORSELLER.md §2.6).
       Mobilde yatay kaydırılır ki telefonlar okunaksız küçülmesin. -->
  <figure class="akis-dis reveal" style="--gecikme: 0.1s">
    <div class="akis-kaydirici">
      <Image
        src={akisZikir}
        alt="Zikir akışı: menüden Namaz Tesbihatı seçimi, oluşan zikir listesi ve zikirmatik sayacı"
        width={1120}
        densities={[1, 2]}
        class="akis-resim"
        loading="lazy"
      />
    </div>
    <figcaption class="akis-altyazi">
      Namaz tesbihatı üç dokunuşla kurulur; gerisi saymaktan ibaret.
    </figcaption>
  </figure>
</section>

<style>
  .kart {
    background: var(--color-yuzey);
    border: 1px solid color-mix(in srgb, var(--color-detay) 28%, transparent);
    border-radius: 20px;
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    box-shadow:
      0 1px 2px rgb(32 34 26 / 4%),
      0 16px 32px -20px rgb(32 34 26 / 14%);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .kart:hover {
    border-color: color-mix(in srgb, var(--color-detay) 50%, transparent);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .kart,
    .kart:hover {
      transition: none;
      transform: none;
    }
  }

  .ikon {
    width: 28px;
    height: 28px;
    color: var(--color-vurgu-koyu);
  }
  .kart h3 {
    margin-top: 1rem;
    font-size: 1.35rem;
  }
  .kart > p {
    margin-top: 0.65rem;
    color: var(--color-soluk);
    line-height: 1.7;
    font-size: 1rem;
  }

  /* Mini demo paneli: kartın içinde küçük, gerçek bir arayüz parçası */
  .demo {
    margin-top: auto;
    padding-top: 1.25rem;
  }
  .demo > div,
  .demo > p {
    background: var(--color-zemin);
  }
  .demo-satir,
  .cubuk,
  .demo-metin,
  .balon {
    border: 1px solid color-mix(in srgb, var(--color-detay) 20%, transparent);
  }
  .demo-satir {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 12px;
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .demo-satir + .demo-satir,
  .demo-satir + .demo-metin {
    margin-top: 0.5rem;
  }
  .demo-satir.vurgulu {
    background: color-mix(in srgb, var(--color-vurgu) 14%, var(--color-zemin));
    border-color: color-mix(in srgb, var(--color-vurgu) 30%, transparent);
    font-weight: 600;
  }
  .yesil {
    color: var(--color-vurgu-koyu);
    font-weight: 600;
  }

  .etiket {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-vurgu-koyu);
    background: color-mix(in srgb, var(--color-vurgu) 12%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
  }
  .demo-ikon {
    width: 16px;
    height: 16px;
    color: var(--color-vurgu-koyu);
  }
  .demo-metin {
    border-radius: 12px;
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .balon {
    border-radius: 14px 14px 14px 4px;
    padding: 0.55rem 0.9rem;
    font-size: 0.88rem;
    width: fit-content;
    max-width: 90%;
  }
  .balon.soru {
    margin-top: 0.5rem;
    margin-left: auto;
    border-radius: 14px 14px 4px 14px;
    background: color-mix(in srgb, var(--color-vurgu) 12%, var(--color-zemin));
    border-color: color-mix(in srgb, var(--color-vurgu) 28%, transparent);
  }

  /* Zikir akışı bandı: çerçeveli beyaz kap, krem zeminden ayrışır */
  .akis-dis {
    margin-top: 3rem;
  }
  .akis-kaydirici {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    background: var(--color-yuzey);
    border: 1px solid color-mix(in srgb, var(--color-detay) 28%, transparent);
    border-radius: 24px;
    box-shadow:
      0 1px 2px rgb(32 34 26 / 4%),
      0 16px 32px -20px rgb(32 34 26 / 14%);
  }
  .akis-resim {
    width: 100%;
    min-width: 860px; /* dar ekranda küçülüp okunaksızlaşmasın; kaydırılır */
    height: auto;
    scroll-snap-align: center;
  }
  @media (min-width: 900px) {
    .akis-resim {
      min-width: 0;
    }
  }
  .akis-altyazi {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-soluk);
  }
</style>
