---
import { Image } from 'astro:assets';

// 9 ekran görüntüsü: assets/app_screenshots/ (Flutter) → src/assets/screenshots/
const screenshots = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/screenshot-*.jpg', {
    eager: true,
  })
).map((mod) => mod.default);
---

<section class="mx-auto max-w-[1200px] px-5 py-12 md:px-12 md:py-16 lg:py-20">
  <h2 class="text-center text-[26px] font-bold text-primary md:text-[28px] xl:text-[32px]">
    Uygulama İçinden
  </h2>
  <ul
    class="mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto py-2 md:mt-8 xl:mt-10"
    aria-label="Uygulama ekran görüntüleri"
  >
    {
      screenshots.map((screenshot, i) => (
        <li class="shrink-0 snap-center">
          <Image
            src={screenshot}
            alt={`İbadet Rehberim uygulaması ekran görüntüsü ${i + 1}`}
            width={320}
            densities={[1, 2]}
            class="w-[160px] rounded-2xl border-[1.5px] border-primary/40 shadow-[0_4px_12px_rgba(104,125,42,0.08)]"
            loading="lazy"
          />
        </li>
      ))
    }
  </ul>
</section>
