---
import MagazaButonlari from './MagazaButonlari.astro';
import TanitimVideosu from './TanitimVideosu.astro';

// Rozetler: yalnızca doğrulanmış gerçekler (SSS içerikleri + mağaza durumu)
const rozetler = ['Ücretsiz', 'Türkçe', 'iOS ve Android'];
---

<section class="kapsayici pt-[clamp(3rem,8vw,5.5rem)] pb-[clamp(2.5rem,6vw,4rem)]">
  <div class="grid items-center gap-12 lg:grid-cols-[7fr_5fr] lg:gap-8">
    <div class="max-w-[560px]">
      <ul class="giris-1 flex flex-wrap gap-2" aria-label="Uygulama hakkında kısa bilgiler">
        {
          rozetler.map((rozet) => (
            <li class="cizgi rounded-full border px-3.5 py-1 text-[0.85rem] font-medium text-soluk">
              {rozet}
            </li>
          ))
        }
      </ul>

      <h1 class="giris-2 mt-6">
        İbadetleriniz için <span class="text-vurgu-koyu">sade bir rehber</span>
      </h1>

      <p class="giris-3 mt-5 max-w-[46ch] text-[1.125rem] leading-[1.7] text-soluk">
        Namaz vakitleri, zikirmatik, dua ve hadisler tek uygulamada. Vakti gelince
        hatırlatır, gerisine karışmaz.
      </p>

      <div class="giris-4 mt-8">
        <MagazaButonlari />
        <p class="mt-4 text-[0.9rem] text-soluk">
          Uygulama ücretsizdir. İsterseniz destek paketiyle reklamsız kullanabilirsiniz.
        </p>
      </div>
    </div>

    <!-- Tanıtım videosu (TanitimVideosu.astro): uygulamanın sessiz, döngülü
         tanıtım videosu; hareket azaltmada poster karesi sabit görünür. -->
    <div class="giris-4">
      <TanitimVideosu />
    </div>
  </div>
</section>
