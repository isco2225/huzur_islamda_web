---
import { Image } from 'astro:assets';
import MagazaButonlari from './MagazaButonlari.astro';
import screenshot1 from '../assets/screenshots/screenshot-1.jpg';
---

<section class="mx-auto max-w-[1200px] px-5 py-12 md:px-12 md:py-16 lg:py-20">
  <div class="flex flex-col items-center gap-8 lg:flex-row lg:gap-14">
    <div class="max-w-[520px] lg:flex-[5]">
      <h1 class="text-[28px] font-bold leading-[1.2] text-primary md:text-[38px] xl:text-[44px]">
        İbadet Rehberiniz<br />Her Zaman Yanınızda
      </h1>
      <p class="mt-4 text-[17px] leading-[1.55] text-ink md:mt-5">
        Kur'an ve sünnet ışığında namaz vakitleri, akıllı zikirmatik, dua-hadis-Kur'an
        içerikleri ve İslami asistan ile ibadetlerinizi düzenli tutun. Ücretsiz indirin.
      </p>
    </div>
    <div
      class="w-[120px] overflow-hidden rounded-[20px] bg-white shadow-[0_10px_22px_rgba(104,125,42,0.12),0_4px_16px_rgba(0,0,0,0.06)] md:w-[140px] md:rounded-[28px] xl:w-[160px]"
    >
      <Image
        src={screenshot1}
        alt="İbadet Rehberim uygulamasının ana ekranından bir görünüm"
        width={320}
        densities={[1, 2]}
        class="h-auto w-full"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <MagazaButonlari class="lg:flex-[2]" />
  </div>
</section>
