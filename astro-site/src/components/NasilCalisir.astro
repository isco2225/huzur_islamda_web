---
// Gerçek akıştan üç adım: ilçe seçimi → bildirimler → günlük kullanım
// (kaynak: lib/screens, UYGULAMA_OZELLIKLERI.md §6-7)
const adimlar = [
  {
    etiket: 'Önce',
    baslik: 'İlçenizi seçin',
    metin:
      'Vakitler, Diyanet İşleri Başkanlığının hesaplama yöntemiyle seçtiğiniz ilçeye göre listelenir; bir sonraki vakte kalan süre her dakika güncellenir.',
  },
  {
    etiket: 'Sonra',
    baslik: 'Hatırlatmaları açın',
    metin:
      'Namaz vakti bildirimleri ve gün bitmeden 22.00 zikir hatırlatması sizi vaktinde uyarır; hepsi ayarlardan açılıp kapatılabilir.',
  },
  {
    etiket: 'Gün boyu',
    baslik: 'Ritmi sürdürün',
    metin:
      'Zikrinizi sayın, dua ve hadis akışınızı okuyun, aklınıza takılanı asistana sorun. Hepsi aynı sakin ekranda.',
  },
];
---

<section id="nasil-calisir" class="bolum kapsayici reveal">
  <p class="eyebrow">Nasıl çalışır</p>
  <h2 class="mt-3 max-w-[20ch]">Üç adım. Bütün gün.</h2>

  <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
    {
      adimlar.map((adim) => (
        <li class="cizgi border-t pt-6">
          <p class="text-[0.875rem] font-medium text-vurgu-koyu">{adim.etiket}</p>
          <h3 class="mt-2 text-[1.35rem]">{adim.baslik}</h3>
          <p class="mt-3 text-[1rem] leading-[1.7] text-soluk">{adim.metin}</p>
        </li>
      ))
    }
  </ol>
</section>
