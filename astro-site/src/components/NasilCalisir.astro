---
// Gerçek akıştan üç adım: ilçe seçimi → bildirimler → günlük kullanım
// (kaynak: lib/screens, UYGULAMA_OZELLIKLERI.md §6-7)
const adimlar = [
  {
    etiket: 'Önce',
    baslik: 'İlçenizi seçin',
    metin:
      'Namaz vakitleri, Diyanet İşleri Başkanlığının hesaplama yöntemiyle ilçenize göre hesaplanır. Bir sonraki vakte ne kadar kaldığını da anlık olarak görürsünüz.',
  },
  {
    etiket: 'Sonra',
    baslik: 'Hatırlatmaları açın',
    metin:
      "Namaz vakitlerinde bildirim alırsınız. Zikirleriniz yarım kaldıysa akşam 22.00'de küçük bir hatırlatma gelir. İstemezseniz ayarlardan kapatırsınız.",
  },
  {
    etiket: 'Gün boyu',
    baslik: 'Gününüze devam edin',
    metin:
      'Ara ara girip zikrinizi sayarsınız, günün dua ve hadislerini okursunuz. Aklınıza takılan bir şey olursa asistana sorarsınız.',
  },
];
---

<!-- Beyaz bant: bölge krem zeminden net ayrılır -->
<section id="nasil-calisir" class="bolum cizgi border-y bg-yuzey">
  <div class="kapsayici">
    <p class="eyebrow reveal">Nasıl çalışır</p>
    <h2 class="reveal mt-4 max-w-[24ch]" style="--gecikme: 0.08s">
      Başlamak için üç adım yeterli
    </h2>

    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        adimlar.map((adim, i) => (
          <li class="reveal cizgi border-t pt-6" style={`--gecikme: ${0.1 + i * 0.12}s`}>
            <p class="text-[0.875rem] font-medium text-vurgu-koyu">{adim.etiket}</p>
            <h3 class="mt-2 text-[1.35rem]">{adim.baslik}</h3>
            <p class="mt-3 text-[1rem] leading-[1.7] text-soluk">{adim.metin}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
