---
// Google Play yayında; App Store henüz yayında değil (buton devre dışı).
// TODO: Uygulama App Store'da yayınlanınca appStoreUrl doldurulup buton aktifleştirilecek.
export const playStoreUrl =
  'https://play.google.com/store/apps/details?id=com.omran.huzur_islamda&hl=tr';
const appStoreUrl = ''; // TODO: App Store URL (henüz yayında değil)

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const appleIcon =
  'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z';
const playIcon =
  'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z';

const buttonClass =
  'inline-flex items-center justify-center gap-2 rounded-[15px] border border-primary px-5 py-3.5 font-semibold text-primary lg:min-w-[220px]';
---

<div class={`flex flex-wrap justify-center gap-3 lg:flex-col lg:justify-start ${className}`}>
  <a
    href={playStoreUrl}
    target="_blank"
    rel="noopener"
    class={`${buttonClass} transition-colors hover:bg-primary/5`}
  >
    <svg viewBox="0 0 24 24" class="h-[22px] w-[22px] fill-current" aria-hidden="true">
      <path d={playIcon} />
    </svg>
    Google Play'den Al
  </a>
  {
    appStoreUrl ? (
      <a
        href={appStoreUrl}
        target="_blank"
        rel="noopener"
        class={`${buttonClass} transition-colors hover:bg-primary/5`}
      >
        <svg viewBox="0 0 24 24" class="h-[22px] w-[22px] fill-current" aria-hidden="true">
          <path d={appleIcon} />
        </svg>
        App Store'dan İndir
      </a>
    ) : (
      <span class={`${buttonClass} cursor-default opacity-50`} title="Yakında App Store'da">
        <svg viewBox="0 0 24 24" class="h-[22px] w-[22px] fill-current" aria-hidden="true">
          <path d={appleIcon} />
        </svg>
        App Store'da Yakında
      </span>
    )
  }
</div>
