---
/*
 * Vakit Kuşağı — sitenin imza öğesi (TASARIM.md §5).
 * Günün altı vakti, geceden şafağa, gündüze, ikindiye, akşam kızıllığına ve
 * tekrar geceye akan saf CSS gökyüzü gradyanı üzerinde işaretlenir.
 * Görsel dosyası yok; 60 sn'lik "nefes" animasyonu reduced-motion'da kapalıdır.
 */
const vakitler = ['İmsak', 'Güneş', 'Öğle', 'İkindi', 'Akşam', 'Yatsı'];
---

<section aria-label="Günün altı vakti" class="kapsayici pb-[clamp(2.5rem,6vw,4rem)]">
  <div class="kusak reveal">
    <div class="serit" aria-hidden="true"></div>
    <ol class="vakitler">
      {
        // Noktalar günün akışı gibi İmsak'tan Yatsı'ya sırayla belirir
        vakitler.map((vakit, i) => (
          <li class="reveal" style={`--gecikme: ${0.25 + i * 0.1}s`}>
            <span class="nokta" aria-hidden="true"></span>
            <span class="ad">{vakit}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .kusak {
    position: relative;
  }

  /* Gökyüzü şeridi: gece → şafak → sabah → gün ortası → ikindi → günbatımı → gece.
     Palet, GORSELLER.md şafak ailesinden türetilmiştir; gül tonları (şafak ve
     günbatımı) dar birer geçiş olarak kullanılır ki altınla karışıp
     çamurlaşmasın. Gün ortası en aydınlık noktadır. */
  .serit {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: var(--serit-boyu);
    border-radius: 24px;
    background-image: linear-gradient(
      100deg,
      #0e1b2a 0%,
      #22335a 9%,
      #966962 17%,
      #e8a45c 25%,
      #f6d18c 37%,
      #fae3a8 50%,
      #f1c77a 63%,
      #d89a55 74%,
      #a06058 83%,
      #2e3a5c 92%,
      #0e1b2a 100%
    );
    /* Üst kenarda tek piksellik ışık, altta gölge: şerit cama dönüşmeden derinlik kazanır */
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 20%),
      inset 0 -1px 0 rgb(14 27 42 / 25%);
  }

  .kusak {
    --serit-boyu: clamp(76px, 10vw, 108px);
  }

  .vakitler {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .vakitler li {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nokta {
    height: var(--serit-boyu);
    display: flex;
    align-items: center;
  }
  /* Krem nokta + yarı saydam koyu halka: hem gece lacivertinde hem gün
     ortası altınında okunur (altın nokta altın zeminde kayboluyordu) */
  .nokta::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-zemin);
    box-shadow:
      0 0 0 3px rgb(14 27 42 / 22%),
      0 1px 3px rgb(14 27 42 / 35%);
  }

  .ad {
    margin-top: 0.75rem;
    font-size: clamp(0.72rem, 1.8vw, 0.92rem);
    font-weight: 500;
    color: var(--color-soluk);
  }

  /* Çok yavaş, zar zor algılanan nefes: yalnız hareket tercihi kısıtlı değilse.
     %106'lık boyut, gün döngüsünün her kadrajda bütün kalmasını sağlar. */
  @media (prefers-reduced-motion: no-preference) {
    .serit {
      background-size: 106% 100%;
      animation: nefes 60s ease-in-out infinite alternate;
    }
    @keyframes nefes {
      from {
        background-position: 0% 50%;
      }
      to {
        background-position: 100% 50%;
      }
    }
  }
</style>
