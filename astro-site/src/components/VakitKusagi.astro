---
/*
 * Gün Döngüsü v2 — sitenin imza öğesi.
 *
 * Sahne Claude Design teslimidir ("Ezan Vakitleri Banner" handoff'u) ve
 * olduğu gibi uyarlanmıştır: İstanbul silüeti (Galata Kulesi, külliye,
 * Kız Kulesi) üzerinde gece → imsak → doğuş → öğle → ikindi → akşam →
 * yatsı → kapanış kartı döngüsü. Akşam vaktinde uygulamanın bildirim
 * kartı, kapanışta vakit özeti + "İmsaka kalan" sayacı görünür.
 *
 * Tamamı HTML + CSS + inline SVG; client JS ve harici varlık yok.
 * Tüm hareket tek ortak döngüye bağlıdır (--dongu: 16s, linear) ve yalnız
 * transform + opacity anime edilir (TASARIM.md §7). Sahne kendi renk
 * paletini scene-local değişkenlerde taşır; site token'larına yalnız
 * çerçeve, fontlar ve kaynak satırı bağlanır.
 *
 * Zaman çizelgesi (döngü yüzdesi): gece 0–3 · imsak 3–13 · doğuş 16–26 ·
 * öğle 29–39 · ikindi 42–52 · akşam + bildirim 55–72 · yatsı + ay 70–80 ·
 * kapanış kartı 82–96 · geceye dönüş 96–100.
 *
 * Saatler uygulamanın kendi Ezan Vakitleri ekranından alınmıştır
 * (İstanbul, 8 Ağustos Cumartesi) — örnek bir gündür, uydurma değildir;
 * "İmsaka kalan 6 sa 25 dk" da 21:54 → 04:19 aralığının gerçek hesabıdır.
 */
import { Image } from 'astro:assets';
import appIcon from '../assets/app_icon.png';
---

<section aria-label="Günün altı vakti — gün döngüsü animasyonu" class="kapsayici pb-[clamp(2.5rem,6vw,4rem)]">
  <div class="cerceve golge reveal">
    <div class="sahne">
      <div class="gok gok-tan" aria-hidden="true"></div>
      <div class="gok gok-gunduz" aria-hidden="true"></div>
      <div class="gok gok-aksam" aria-hidden="true"></div>

      <div class="yildizlar" aria-hidden="true">
        <i style="left:6%;top:14%"></i><i style="left:14%;top:38%"></i><i style="left:22%;top:9%"></i>
        <i style="left:31%;top:27%"></i><i style="left:40%;top:12%"></i><i style="left:48%;top:34%"></i>
        <i style="left:56%;top:8%"></i><i style="left:63%;top:24%"></i><i style="left:71%;top:15%"></i>
        <i style="left:79%;top:33%"></i><i style="left:87%;top:10%"></i><i style="left:94%;top:26%"></i>
      </div>

      <div class="isilti isilti-tan" aria-hidden="true"></div>
      <div class="isilti isilti-aksam" aria-hidden="true"></div>

      <div class="gunes" aria-hidden="true">
        <div class="gunes-govde"><div class="gunes-kizil"></div></div>
      </div>

      <div class="ay" aria-hidden="true"><div class="ay-govde"><div class="ay-kesik"></div></div></div>

      <!-- Masaüstü silüet: Galata Kulesi, külliye, Kız Kulesi -->
      <svg class="siluet siluet-masa" viewBox="0 0 1920 300" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
        <path fill="var(--sil-gunduz)" d="M0 300 L0 205 L54 205 L54 178 L110 178 L110 214 L176 214 L176 188 L240 188 L240 240 L306 240 L306 112 L296 112 L296 94 L304 94 L330 26 L356 94 L364 94 L364 112 L354 112 L354 240 L420 240 L420 208 L488 208 L488 232 L556 232 L556 200 L620 200 L620 236 L700 236 L700 222 L725 222 L725 150 L720 150 L720 140 L725 140 L725 110 L720 110 L720 100 L725 100 L725 70 L730 30 L735 70 L735 100 L740 100 L740 110 L735 110 L735 140 L740 140 L740 150 L735 150 L735 222 L844 222 L844 162 L840 162 L840 152 L844 152 L844 98 L848 64 L852 98 L852 152 L856 152 L856 162 L852 162 L852 222 L870 222 L870 202 A30 30 0 0 1 930 202 L938 202 L938 168 A62 76 0 0 1 1062 168 L1062 202 L1070 202 A30 30 0 0 1 1130 202 L1130 222 L1148 222 L1148 162 L1144 162 L1144 152 L1148 152 L1148 98 L1152 64 L1156 98 L1156 152 L1160 152 L1160 162 L1156 162 L1156 222 L1265 222 L1265 150 L1260 150 L1260 140 L1265 140 L1265 110 L1260 110 L1260 100 L1265 100 L1265 70 L1270 30 L1275 70 L1275 100 L1280 100 L1280 110 L1275 110 L1275 140 L1280 140 L1280 150 L1275 150 L1275 222 L1300 222 L1300 240 L1360 240 L1360 212 L1430 212 L1430 238 L1500 238 L1500 206 L1566 206 L1566 234 L1640 234 L1640 246 L1728 246 L1728 158 L1720 158 L1720 146 L1740 146 L1740 112 L1750 84 L1760 112 L1760 146 L1780 146 L1780 158 L1772 158 L1772 246 L1830 246 L1830 218 L1886 218 L1886 236 L1920 236 L1920 300 Z M996 94 L1000 60 L1004 94 Z"/>
        <path class="sil-gece" fill="var(--sil-gece)" d="M0 300 L0 205 L54 205 L54 178 L110 178 L110 214 L176 214 L176 188 L240 188 L240 240 L306 240 L306 112 L296 112 L296 94 L304 94 L330 26 L356 94 L364 94 L364 112 L354 112 L354 240 L420 240 L420 208 L488 208 L488 232 L556 232 L556 200 L620 200 L620 236 L700 236 L700 222 L725 222 L725 150 L720 150 L720 140 L725 140 L725 110 L720 110 L720 100 L725 100 L725 70 L730 30 L735 70 L735 100 L740 100 L740 110 L735 110 L735 140 L740 140 L740 150 L735 150 L735 222 L844 222 L844 162 L840 162 L840 152 L844 152 L844 98 L848 64 L852 98 L852 152 L856 152 L856 162 L852 162 L852 222 L870 222 L870 202 A30 30 0 0 1 930 202 L938 202 L938 168 A62 76 0 0 1 1062 168 L1062 202 L1070 202 A30 30 0 0 1 1130 202 L1130 222 L1148 222 L1148 162 L1144 162 L1144 152 L1148 152 L1148 98 L1152 64 L1156 98 L1156 152 L1160 152 L1160 162 L1156 162 L1156 222 L1265 222 L1265 150 L1260 150 L1260 140 L1265 140 L1265 110 L1260 110 L1260 100 L1265 100 L1265 70 L1270 30 L1275 70 L1275 100 L1280 100 L1280 110 L1275 110 L1275 140 L1280 140 L1280 150 L1275 150 L1275 222 L1300 222 L1300 240 L1360 240 L1360 212 L1430 212 L1430 238 L1500 238 L1500 206 L1566 206 L1566 234 L1640 234 L1640 246 L1728 246 L1728 158 L1720 158 L1720 146 L1740 146 L1740 112 L1750 84 L1760 112 L1760 146 L1780 146 L1780 158 L1772 158 L1772 246 L1830 246 L1830 218 L1886 218 L1886 236 L1920 236 L1920 300 Z M996 94 L1000 60 L1004 94 Z"/>
        <g class="pencereler" fill="var(--pencere)">
          <rect x="26" y="222" width="10" height="14" rx="2"/><rect x="140" y="232" width="10" height="14" rx="2"/>
          <rect x="206" y="210" width="10" height="14" rx="2"/><rect x="322" y="150" width="10" height="14" rx="2"/>
          <rect x="450" y="226" width="10" height="14" rx="2"/><rect x="584" y="220" width="10" height="14" rx="2"/>
          <rect x="660" y="252" width="10" height="14" rx="2"/><rect x="760" y="238" width="10" height="14" rx="2"/>
          <rect x="1240" y="238" width="10" height="14" rx="2"/><rect x="1392" y="232" width="10" height="14" rx="2"/>
          <rect x="1530" y="226" width="10" height="14" rx="2"/><rect x="1854" y="236" width="10" height="14" rx="2"/>
        </g>
      </svg>
      <!-- Dar ekran silüeti: külliyeye kırpılmış -->
      <svg class="siluet siluet-cep" viewBox="560 0 860 300" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
        <path fill="var(--sil-gunduz)" d="M560 300 L560 232 L556 232 L556 200 L620 200 L620 236 L700 236 L700 222 L725 222 L725 150 L720 150 L720 140 L725 140 L725 110 L720 110 L720 100 L725 100 L725 70 L730 30 L735 70 L735 100 L740 100 L740 110 L735 110 L735 140 L740 140 L740 150 L735 150 L735 222 L844 222 L844 162 L840 162 L840 152 L844 152 L844 98 L848 64 L852 98 L852 152 L856 152 L856 162 L852 162 L852 222 L870 222 L870 202 A30 30 0 0 1 930 202 L938 202 L938 168 A62 76 0 0 1 1062 168 L1062 202 L1070 202 A30 30 0 0 1 1130 202 L1130 222 L1148 222 L1148 162 L1144 162 L1144 152 L1148 152 L1148 98 L1152 64 L1156 98 L1156 152 L1160 152 L1160 162 L1156 162 L1156 222 L1265 222 L1265 150 L1260 150 L1260 140 L1265 140 L1265 110 L1260 110 L1260 100 L1265 100 L1265 70 L1270 30 L1275 70 L1275 100 L1280 100 L1280 110 L1275 110 L1275 140 L1280 140 L1280 150 L1275 150 L1275 222 L1300 222 L1300 240 L1360 240 L1360 212 L1420 212 L1420 300 Z M996 94 L1000 60 L1004 94 Z"/>
        <path class="sil-gece" fill="var(--sil-gece)" d="M560 300 L560 232 L556 232 L556 200 L620 200 L620 236 L700 236 L700 222 L725 222 L725 150 L720 150 L720 140 L725 140 L725 110 L720 110 L720 100 L725 100 L725 70 L730 30 L735 70 L735 100 L740 100 L740 110 L735 110 L735 140 L740 140 L740 150 L735 150 L735 222 L844 222 L844 162 L840 162 L840 152 L844 152 L844 98 L848 64 L852 98 L852 152 L856 152 L856 162 L852 162 L852 222 L870 222 L870 202 A30 30 0 0 1 930 202 L938 202 L938 168 A62 76 0 0 1 1062 168 L1062 202 L1070 202 A30 30 0 0 1 1130 202 L1130 222 L1148 222 L1148 162 L1144 162 L1144 152 L1148 152 L1148 98 L1152 64 L1156 98 L1156 152 L1160 152 L1160 162 L1156 162 L1156 222 L1265 222 L1265 150 L1260 150 L1260 140 L1265 140 L1265 110 L1260 110 L1260 100 L1265 100 L1265 70 L1270 30 L1275 70 L1275 100 L1280 100 L1280 110 L1275 110 L1275 140 L1280 140 L1280 150 L1275 150 L1275 222 L1300 222 L1300 240 L1360 240 L1360 212 L1420 212 L1420 300 Z M996 94 L1000 60 L1004 94 Z"/>
        <g class="pencereler" fill="var(--pencere)">
          <rect x="584" y="220" width="10" height="14" rx="2"/><rect x="660" y="252" width="10" height="14" rx="2"/>
          <rect x="700" y="248" width="10" height="14" rx="2"/><rect x="760" y="238" width="10" height="14" rx="2"/>
          <rect x="1240" y="238" width="10" height="14" rx="2"/><rect x="1330" y="246" width="10" height="14" rx="2"/>
          <rect x="1392" y="232" width="10" height="14" rx="2"/>
        </g>
      </svg>

      <div class="vakit vakit-1"><small>Vakit</small><strong>İmsak</strong><b></b><em class="rakam">04:19</em></div>
      <div class="vakit vakit-2"><small>Vakit</small><strong>Güneş</strong><b></b><em class="rakam">06:00</em></div>
      <div class="vakit vakit-3 vakit-koyu"><small>Vakit</small><strong>Öğle</strong><b></b><em class="rakam">13:15</em></div>
      <div class="vakit vakit-4 vakit-koyu"><small>Vakit</small><strong>İkindi</strong><b></b><em class="rakam">17:07</em></div>
      <div class="vakit vakit-5"><small>Vakit</small><strong>Akşam</strong><b></b><em class="rakam">20:20</em></div>
      <div class="vakit vakit-6"><small>Vakit</small><strong>Yatsı</strong><b></b><em class="rakam">21:54</em></div>

      <div class="bildirim">
        <Image src={appIcon} alt="" class="simge" />
        <div><h4>İbadet Rehberim</h4><p>Akşam ezanı vakti girdi · 20:20</p></div>
        <span>şimdi</span>
      </div>

      <div class="kart-sarma">
        <div class="kart">
          <Image src={appIcon} alt="" class="simge" />
          <div class="kart-baslik">
            <h3>Ezan Vakitleri</h3>
            <p>İstanbul, Türkiye · 8 Ağustos, Cumartesi</p>
          </div>
          <div class="rozet"><strong>İmsak</strong><i>Sıradaki</i><em class="rakam">04:19</em></div>
          <div class="sayac"><small>İmsaka kalan</small><strong>6 sa 25 dk</strong></div>
        </div>
      </div>
    </div>
  </div>
  <p class="kaynak">Örnek bir gün — İstanbul, 8 Ağustos Cumartesi</p>
</section>

<style>
  .cerceve {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-detay) 30%, transparent);
    border-radius: 24px;
    background: #0d1f16;
  }

  /* ── Sahne: renk paleti scene-local, hareket tek döngüde ── */
  .sahne {
    --dongu: 16s;
    --gece-ust: #0d1f16;
    --gece-alt: #1a3626;
    --tan-ust: #14301f;
    --tan-alt: #b57a4a;
    --gunduz-ust: #79aab4;
    --gunduz-alt: #dde3cc;
    --aksam-ust: #3d5a45;
    --aksam-alt: #d98a55;
    --krem: #f7f4e8;
    --fildisi: #f6f3e4;
    --murekkep: #1f3320;
    --vurgu: #6d8f3d;
    --acik: #a9c87f;
    --koyu-yesil: #1d3a28;
    --secili: #cfdfb0;
    --pencere: #ecc26f;
    --sil-gunduz: #28402e;
    --sil-gece: #0a1810;
    --gunes-altin: #ffdf8f;
    --gunes-kizil: #e2603c;
    --yildiz: #e9efdf;

    position: relative;
    width: 100%;
    height: 300px;
    overflow: hidden;
    container-type: inline-size;
    background: linear-gradient(180deg, var(--gece-ust), var(--gece-alt));
  }
  @media (max-width: 430px) {
    .sahne { height: 280px; }
  }

  /* ── Gökyüzü katmanları (opaklıkla geçiş) ── */
  .gok { position: absolute; inset: 0; }
  .gok-tan { background: linear-gradient(180deg, var(--tan-ust) 30%, var(--tan-alt)); opacity: 0; animation: tanKat var(--dongu) linear infinite; }
  .gok-gunduz { background: linear-gradient(180deg, var(--gunduz-ust), var(--gunduz-alt)); opacity: 0; animation: gunduzKat var(--dongu) linear infinite; }
  .gok-aksam { background: linear-gradient(180deg, var(--aksam-ust), var(--aksam-alt)); opacity: 1; animation: aksamKat var(--dongu) linear infinite; }
  @keyframes tanKat { 0%, 4% { opacity: 0; } 12% { opacity: 0.9; } 24%, 100% { opacity: 0; } }
  @keyframes gunduzKat { 0%, 20% { opacity: 0; } 33% { opacity: 1; } 50% { opacity: 1; } 64%, 100% { opacity: 0; } }
  @keyframes aksamKat { 0%, 50% { opacity: 0; } 60% { opacity: 1; } 66% { opacity: 1; } 76%, 100% { opacity: 0; } }

  /* ── Yıldızlar ── */
  .yildizlar { position: absolute; inset: 0; opacity: 0; animation: geceKapisi var(--dongu) linear infinite; }
  .yildizlar i { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: var(--yildiz); animation: kirp var(--dongu) linear infinite; }
  .yildizlar i:nth-child(2n) { width: 2px; height: 2px; animation-delay: -4s; }
  .yildizlar i:nth-child(3n) { animation-delay: -9s; }
  .yildizlar i:nth-child(5n) { animation-delay: -13s; }
  @keyframes geceKapisi { 0% { opacity: 1; } 18% { opacity: 0; } 62% { opacity: 0; } 72%, 100% { opacity: 1; } }
  @keyframes kirp { 0%, 100% { opacity: 0.9; } 25% { opacity: 0.35; } 50% { opacity: 0.8; } 75% { opacity: 0.3; } }

  /* ── Ufuk ışıltıları ── */
  .isilti {
    position: absolute;
    width: 46cqw;
    height: 200px;
    opacity: 0;
    background: radial-gradient(ellipse at center, rgb(233 166 94 / 80%) 0%, rgb(233 166 94 / 0%) 62%);
  }
  .isilti-tan { left: -8cqw; bottom: -30px; animation: tanIsilti var(--dongu) linear infinite; }
  .isilti-aksam {
    right: -6cqw;
    bottom: -30px;
    opacity: 0.5;
    background: radial-gradient(ellipse at center, rgb(226 96 60 / 75%) 0%, rgb(226 96 60 / 0%) 62%);
    animation: aksamIsilti var(--dongu) linear infinite;
  }
  @keyframes tanIsilti { 0%, 3% { opacity: 0; } 9% { opacity: 0.55; } 20%, 100% { opacity: 0; } }
  @keyframes aksamIsilti { 0%, 52% { opacity: 0; } 62% { opacity: 0.55; } 74%, 100% { opacity: 0; } }

  /* ── Güneş: konum yalnız translate ile, yay keyframe basamaklarında ── */
  .gunes {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 1;
    transform: translate(74cqw, 168px);
    animation: gunesYol var(--dongu) linear infinite, gunesGoster var(--dongu) linear infinite;
  }
  .gunes-govde {
    position: relative;
    width: clamp(56px, 9.6cqw, 100px);
    height: clamp(56px, 9.6cqw, 100px);
    margin-left: calc(clamp(56px, 9.6cqw, 100px) / -2);
    margin-top: calc(clamp(56px, 9.6cqw, 100px) / -2);
    border-radius: 50%;
    background: radial-gradient(circle at 42% 38%, #fff3cf 0%, var(--gunes-altin) 68%);
    box-shadow: 0 0 60px 18px rgb(246 189 102 / 45%);
  }
  .gunes-kizil {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    opacity: 0.65;
    background: radial-gradient(circle at 42% 38%, #ffd9b0 0%, var(--gunes-kizil) 70%);
    animation: kizilTon var(--dongu) linear infinite;
  }
  @keyframes gunesYol {
    0%, 10% { transform: translate(6cqw, 265px); }
    16% { transform: translate(11.5cqw, 185px); animation-timing-function: ease-in-out; }
    38% { transform: translate(46cqw, 62px); animation-timing-function: ease-in-out; }
    50% { transform: translate(58cqw, 92px); animation-timing-function: ease-in-out; }
    62% { transform: translate(74cqw, 168px); animation-timing-function: ease-in-out; }
    68%, 100% { transform: translate(85cqw, 262px); }
  }
  @keyframes gunesGoster { 0%, 12% { opacity: 0; } 17% { opacity: 1; } 63% { opacity: 1; } 69%, 100% { opacity: 0; } }
  @keyframes kizilTon { 0% { opacity: 0.7; } 20% { opacity: 0; } 52% { opacity: 0; } 64%, 100% { opacity: 0.72; } }

  /* ── Ay ── */
  .ay { position: absolute; right: 12cqw; top: 36px; opacity: 0; transform: translateY(150px); animation: ayYol var(--dongu) linear infinite; }
  .ay-govde {
    position: relative;
    width: clamp(34px, 5.4cqw, 56px);
    height: clamp(34px, 5.4cqw, 56px);
    border-radius: 50%;
    background: #f2eed8;
    overflow: hidden;
    box-shadow: 0 0 26px rgb(240 236 214 / 45%);
  }
  .ay-kesik { position: absolute; left: 30%; top: -16%; width: 94%; height: 94%; border-radius: 50%; background: var(--gece-ust); }
  @keyframes ayYol {
    0%, 70% { opacity: 0; transform: translateY(150px); }
    78% { opacity: 1; transform: translateY(0); }
    92% { opacity: 1; transform: translateY(0); }
    97%, 100% { opacity: 0; transform: translateY(0); }
  }

  /* ── İstanbul silüeti ── */
  .siluet { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: auto; display: block; }
  .siluet-cep { display: none; }
  @media (max-width: 560px) {
    .siluet-masa { display: none; }
    .siluet-cep { display: block; }
  }
  .sil-gece { opacity: 1; animation: silGece var(--dongu) linear infinite; }
  @keyframes silGece { 0% { opacity: 1; } 22% { opacity: 1; } 33% { opacity: 0; } 58% { opacity: 0; } 74%, 100% { opacity: 1; } }
  .pencereler { opacity: 0.5; animation: geceKapisi var(--dongu) linear infinite; }
  .pencereler rect { animation: kirp var(--dongu) linear infinite; }
  .pencereler rect:nth-child(2n) { animation-delay: -6s; }
  .pencereler rect:nth-child(3n) { animation-delay: -11s; }

  /* ── Vakit etiketi: sırası gelen vakit sol üstte belirir ── */
  .vakit {
    position: absolute;
    left: clamp(14px, 3.6cqw, 42px);
    top: clamp(22px, 5.4cqw, 48px);
    color: var(--fildisi);
    opacity: 0;
    text-shadow: 0 1px 16px rgb(8 18 12 / 30%);
  }
  .vakit-koyu { color: var(--murekkep); text-shadow: none; }
  .vakit small { display: block; font-size: clamp(9px, 1.25cqw, 13px); font-weight: 700; letter-spacing: 0.32em; opacity: 0.62; }
  .vakit strong { display: block; font-family: var(--font-baslik); font-weight: 600; font-size: clamp(24px, 5.2cqw, 52px); line-height: 1.12; }
  .vakit b { display: block; width: clamp(24px, 4cqw, 42px); height: 3px; border-radius: 2px; background: var(--acik); margin: clamp(3px, 0.7cqw, 8px) 0; }
  .vakit-koyu b { background: var(--vurgu); }
  .vakit em { font-style: normal; font-weight: 800; font-size: clamp(15px, 2.9cqw, 29px); opacity: 0.92; }
  .vakit-1 { animation: v1 var(--dongu) linear infinite; }
  .vakit-2 { animation: v2 var(--dongu) linear infinite; }
  .vakit-3 { animation: v3 var(--dongu) linear infinite; }
  .vakit-4 { animation: v4 var(--dongu) linear infinite; }
  .vakit-5 { opacity: 1; animation: v5 var(--dongu) linear infinite; }
  .vakit-6 { animation: v6 var(--dongu) linear infinite; }
  @keyframes v1 { 0%, 3% { opacity: 0; transform: translateY(12px); } 5.5% { opacity: 1; transform: none; } 11.5% { opacity: 1; } 13%, 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes v2 { 0%, 16% { opacity: 0; transform: translateY(12px); } 18.5% { opacity: 1; transform: none; } 24.5% { opacity: 1; } 26%, 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes v3 { 0%, 29% { opacity: 0; transform: translateY(12px); } 31.5% { opacity: 1; transform: none; } 37.5% { opacity: 1; } 39%, 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes v4 { 0%, 42% { opacity: 0; transform: translateY(12px); } 44.5% { opacity: 1; transform: none; } 50.5% { opacity: 1; } 52%, 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes v5 { 0%, 55% { opacity: 0; transform: translateY(12px); } 57.5% { opacity: 1; transform: none; } 65.5% { opacity: 1; } 67%, 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes v6 { 0%, 70% { opacity: 0; transform: translateY(12px); } 72.5% { opacity: 1; transform: none; } 78% { opacity: 1; } 79.5%, 100% { opacity: 0; transform: translateY(-6px); } }

  /* ── Bildirim kartı (akşam vaktinde) ── */
  .bildirim {
    position: absolute;
    top: clamp(8px, 2.2cqw, 22px);
    right: clamp(8px, 2.2cqw, 22px);
    width: clamp(212px, 30cqw, 306px);
    background: var(--krem);
