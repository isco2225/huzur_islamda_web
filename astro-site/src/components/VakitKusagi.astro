---
/*
 * Vakit Yayı — sitenin imza öğesi (TASARIM.md §5).
 * Namaz vakitleri güneşin gökyüzündeki konumuyla tanımlanır; öğe de tam bunu
 * çizer: ince bir ufuk çizgisi, güneşin doğuştan batışa yayı ve yay üzerinde
 * vakitler. İmsak ile Yatsı ufkun gece tarafındadır. Küçük güneş, yayı 60
 * saniyede bir kez kateder (SMIL; prefers-reduced-motion'da sabit güneş
 * gösterilir). Tamamı inline SVG + CSS — görsel dosyası yok.
 *
 * Geometri: elips merkezi (500,210), rx=370, ry=155.
 * Öğle (500,55) tepe · İkindi θ=45° → (762,100) · Güneş/Akşam ufukta.
 */
---

<section aria-label="Günün altı vakti" class="kapsayici pb-[clamp(2.5rem,6vw,4rem)]">
  <figure class="yay reveal">
    <svg viewBox="0 0 1000 300" class="yay-svg" role="img" aria-labelledby="yay-baslik">
      <title id="yay-baslik">
        Günün altı vakti: Güneş, Öğle, İkindi ve Akşam güneşin gökyüzü yayı üzerinde;
        İmsak ve Yatsı ufkun gece tarafında
      </title>
      <defs>
        <linearGradient id="yay-grad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#22335a"></stop>
          <stop offset="0.16" stop-color="#e8a45c"></stop>
          <stop offset="0.5" stop-color="#f1c77a"></stop>
          <stop offset="0.84" stop-color="#d89a55"></stop>
          <stop offset="1" stop-color="#22335a"></stop>
        </linearGradient>
        <!-- userSpaceOnUse: yatay çizgide objectBoundingBox gradyanı çizilmez -->
        <linearGradient id="ufuk-grad" gradientUnits="userSpaceOnUse" x1="20" y1="0" x2="980" y2="0">
          <stop offset="0" stop-color="#0e1b2a"></stop>
          <stop offset="0.14" stop-color="#b9944a" stop-opacity="0.45"></stop>
          <stop offset="0.86" stop-color="#b9944a" stop-opacity="0.45"></stop>
          <stop offset="1" stop-color="#0e1b2a"></stop>
        </linearGradient>
      </defs>

      <!-- Ufuk çizgisi: uçları geceye kararır -->
      <line x1="20" y1="210" x2="980" y2="210" stroke="url(#ufuk-grad)" stroke-width="2"></line>

      <!-- Güneşin yolu -->
      <path
        id="gunes-yolu"
        d="M 130 210 A 370 155 0 0 1 870 210"
        fill="none"
        stroke="url(#yay-grad)"
        stroke-width="4"
        stroke-linecap="round"></path>

      <!-- Yayı 60 sn'de kateden güneş -->
      <g class="gunes" aria-hidden="true">
        <circle r="16" fill="#fae3a8" opacity="0.35"></circle>
        <circle r="8" fill="#fae3a8" stroke="#fff6dc" stroke-width="2"></circle>
        <animateMotion dur="60s" repeatCount="indefinite">
          <mpath href="#gunes-yolu"></mpath>
        </animateMotion>
      </g>
      <!-- Hareket azaltma tercihinde: sabit güneş -->
      <g class="gunes-sabit" transform="translate(640 67)" aria-hidden="true">
        <circle r="16" fill="#fae3a8" opacity="0.35"></circle>
        <circle r="8" fill="#fae3a8" stroke="#fff6dc" stroke-width="2"></circle>
      </g>

      <!-- Vakitler: noktalar + adlar (İmsak'tan Yatsı'ya kademeli belirir) -->
      <g class="vakitler reveal-grup">
        <g>
          <circle cx="48" cy="210" r="7" class="nokta-gece"></circle>
          <text x="48" y="290" text-anchor="middle" class="ad ad-gece">İmsak</text>
        </g>
        <g>
          <circle cx="130" cy="210" r="7" class="nokta-gun"></circle>
          <text x="130" y="254" text-anchor="middle" class="ad">Güneş</text>
        </g>
        <g>
          <circle cx="500" cy="55" r="7" class="nokta-gun"></circle>
          <text x="500" y="30" text-anchor="middle" class="ad">Öğle</text>
        </g>
        <g>
          <circle cx="762" cy="100" r="7" class="nokta-gun"></circle>
          <text x="752" y="148" text-anchor="middle" class="ad">İkindi</text>
        </g>
        <g>
          <circle cx="870" cy="210" r="7" class="nokta-gun"></circle>
          <text x="870" y="254" text-anchor="middle" class="ad">Akşam</text>
        </g>
        <g>
          <circle cx="950" cy="210" r="7" class="nokta-gece"></circle>
          <text x="950" y="290" text-anchor="middle" class="ad ad-gece">Yatsı</text>
        </g>
      </g>
    </svg>
  </figure>
</section>

<style>
  .yay-svg {
    display: block;
    width: 100%;
    max-width: 880px;
    height: auto;
    margin-inline: auto;
  }

  /* Gündüz noktaları: krem + koyu halka; gece noktaları: lacivert + krem halka */
  .nokta-gun {
    fill: var(--color-zemin);
    stroke: rgb(14 27 42 / 35%);
    stroke-width: 2.5;
  }
  .nokta-gece {
    fill: #22335a;
    stroke: rgb(250 248 235 / 55%);
    stroke-width: 2.5;
  }

  .ad {
    font-size: 30px;
    font-weight: 500;
    fill: var(--color-murekkep);
  }
  /* Dar ekranda viewBox küçüldüğü için etiketler büyütülür (~15px görünür boyut) */
  @media (max-width: 640px) {
    .ad {
      font-size: 42px;
    }
  }
  .ad-gece {
    fill: var(--color-soluk);
  }

  /* Güneş: hareket tercihi kısıtlıysa sabit hali gösterilir */
  .gunes-sabit {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .gunes {
      display: none;
    }
    .gunes-sabit {
      display: initial;
    }
  }
</style>
