---
/**
 * Abdest rehberindeki farz kartlarının beden haritası (TASARIM.md §7, 5. kalem).
 *
 * Yüz, kollar ve ayaklar kartlarında aynı figür durur (yüzsüz; kollar dirseğin,
 * paçalar topuğun üstünde); baş kartında baş yukarıdan, dört dilime bölünmüş
 * görünür. Yalnız o farzın kapsadığı bölge mavi dolar ve sınırı altın çizgiyle
 * işaretlenir: yüz saç bitiminden çeneye, kollar dirsekler dahil, başın dörtte
 * biri, ayaklar topuklar dahil. Dolum parça parça yalnız opaklıkla ilerler.
 * Dekoratiftir (aria-hidden); kart `.goster` olunca döngüde oynar. JS'siz ya da
 * hareket azaltmada bölge dolu ve sınır işaretli sabit durur.
 */
export type Farz = 'yuz' | 'kollar' | 'bas' | 'ayaklar';

interface Props {
  farz: Farz;
}

const { farz } = Astro.props;

// Yüz kartında figür başa yakınlaşır; bölge küçük kalmasın
const kadraj = farz === 'yuz' ? 'translate(45 44) scale(2.7) translate(-45 -17)' : undefined;
---

<span class="farz-cizim" aria-hidden="true">
  <svg viewBox="0 0 90 120">
    {
      farz === 'bas' && (
        <>
          {/* Baş yukarıdan: öne bakan burun ucu, yanlarda kulaklar, dört dilim */}
          <ellipse class="kumas" cx="45" cy="70" rx="42" ry="17" />
          <ellipse class="ten" cx="45" cy="35" rx="4" ry="4.5" />
          <ellipse class="ten" cx="21" cy="62" rx="3" ry="6" />
          <ellipse class="ten" cx="69" cy="62" rx="3" ry="6" />
          <circle class="sac" cx="45" cy="62" r="24" />
          <path class="dilim" d="M28.03 45.03 L61.97 78.97 M61.97 45.03 L28.03 78.97" />
          <path class="su p2" d="M45 62 L28.03 45.03 A24 24 0 0 1 61.97 45.03 Z" />
          <path class="sinir" d="M45 62 L28.03 45.03 A24 24 0 0 1 61.97 45.03 Z" />
          <text class="yon" x="45" y="24" text-anchor="middle">ön</text>
        </>
      )
    }
    {farz !== 'bas' && (
    <g transform={kadraj}>
    {/* Figür */}
    <path class="kumas" d="M33 68 L57 68 L58.5 104 L47.5 104 L45 80 L42.5 104 L31.5 104 Z" />
    <rect class="ten" x="34" y="102" width="7" height="9" rx="2" />
    <rect class="ten" x="49" y="102" width="7" height="9" rx="2" />
    <ellipse class="ten" cx="36.5" cy="113" rx="6" ry="3.2" />
    <ellipse class="ten" cx="53.5" cy="113" rx="6" ry="3.2" />
    <circle class="ten-golge" cx="34.2" cy="108" r="1.3" />
    <circle class="ten-golge" cx="40.8" cy="108" r="1.3" />
    <circle class="ten-golge" cx="49.2" cy="108" r="1.3" />
    <circle class="ten-golge" cx="55.8" cy="108" r="1.3" />
    <path class="kumas-golge" d="M31.5 101 h11.2 v3.5 h-11.2 Z M47.3 101 h11.2 v3.5 h-11.2 Z" />

    <path class="kol" d="M30 35 L25.5 55 L22.5 73" />
    <path class="kol" d="M60 35 L64.5 55 L67.5 73" />
    <ellipse class="ten" cx="22" cy="78" rx="3.4" ry="5.5" />
    <ellipse class="ten" cx="68" cy="78" rx="3.4" ry="5.5" />
    <path class="kumas" d="M29 33 C34 30 39 31 45 31 C51 31 56 30 61 33 L63 47 L58 48 L57.5 69 L32.5 69 L32 48 L27 47 Z" />
    <path class="rulo" d="M25.6 47.6 L31.6 48.6 M64.4 47.6 L58.4 48.6" />

    <rect class="ten-golge" x="41.5" y="25" width="7" height="7" rx="2" />
    <ellipse class="ten" cx="36.5" cy="18" rx="2" ry="3.5" />
    <ellipse class="ten" cx="53.5" cy="18" rx="2" ry="3.5" />
    <ellipse class="ten" cx="45" cy="17" rx="8.5" ry="10.5" />
    <path class="sac" d="M36.6 16 C35.6 6 40.5 3 45 3 C49.5 3 54.4 6 53.4 16 C52 11 49.5 9 45 9 C40.5 9 38 11 36.6 16 Z" />

    {/* Farzın kapsadığı bölge: parçalar sırayla dolar */}
    {
      farz === 'yuz' && (
        <>
          <clipPath id="farz-yuz-kirp">
            <ellipse cx="45" cy="17" rx="8.5" ry="10.5" />
          </clipPath>
          <g clip-path="url(#farz-yuz-kirp)">
            <rect class="su p1" x="35" y="8" width="20" height="7.5" />
            <rect class="su p2" x="35" y="15.5" width="20" height="6.5" />
            <rect class="su p3" x="35" y="22" width="20" height="7" />
          </g>
          <ellipse class="sinir" cx="45" cy="17" rx="8.5" ry="10.5" />
          {/* Saç ıslaklığın üstünde kalır: yüz saç bitiminde başlar */}
          <path class="sac" d="M36.6 16 C35.6 6 40.5 3 45 3 C49.5 3 54.4 6 53.4 16 C52 11 49.5 9 45 9 C40.5 9 38 11 36.6 16 Z" />
          <path class="sinir" d="M36.6 16 C38 11 40.5 9 45 9 C49.5 9 52 11 53.4 16" />
        </>
      )
    }
    {
      farz === 'kollar' && (
        <>
          <ellipse class="su p1" cx="22" cy="78" rx="3.4" ry="5.5" />
          <ellipse class="su p1" cx="68" cy="78" rx="3.4" ry="5.5" />
          <path class="su-kol p2" d="M24 64 L22.5 73 M66 64 L67.5 73" />
          <path class="su-kol p3" d="M27.6 50 L25.5 55 L24 64 M62.4 50 L64.5 55 L66 64" />
          <path class="sinir" d="M23.6 50.2 L31.4 51.4 M66.4 50.2 L58.6 51.4" />
        </>
      )
    }
    {
      farz === 'ayaklar' && (
        <>
          <ellipse class="su p1" cx="36.5" cy="113" rx="6" ry="3.2" />
          <ellipse class="su p1" cx="53.5" cy="113" rx="6" ry="3.2" />
          <rect class="su p2" x="34" y="107" width="7" height="4" />
          <rect class="su p2" x="49" y="107" width="7" height="4" />
          <rect class="su p3" x="34" y="104.5" width="7" height="2.5" />
          <rect class="su p3" x="49" y="104.5" width="7" height="2.5" />
          <path class="sinir" d="M32.8 104.6 h9.4 M47.8 104.6 h9.4" />
        </>
      )
    }
    </g>
    )}
  </svg>
</span>

<style>
  .farz-cizim {
    --ten: color-mix(in srgb, var(--color-detay) 55%, var(--color-zemin));
    --ten-golge: color-mix(in srgb, var(--color-detay) 85%, var(--color-murekkep));
    --sac: color-mix(in srgb, var(--color-detay) 45%, var(--color-murekkep));
    --kumas: color-mix(in srgb, var(--color-zemin) 80%, var(--color-gece));
    --kumas-golge: color-mix(in srgb, var(--color-zemin) 58%, var(--color-gece));
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    background: var(--color-vurgu-koyu);
    overflow: hidden;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ten { fill: var(--ten); }
  .ten-golge { fill: var(--ten-golge); }
  .sac { fill: var(--sac); }
  .kumas { fill: var(--kumas); }
  .kumas-golge { fill: var(--kumas-golge); }
  .kol,
  .su-kol,
  .rulo {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .kol {
    stroke: var(--ten);
    stroke-width: 6;
  }
  .rulo {
    stroke: var(--kumas-golge);
    stroke-width: 3.6;
  }
  .su { fill: var(--color-su); }
  .dilim {
    fill: none;
    stroke: var(--ten-golge);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }
  .yon {
    fill: var(--color-zemin);
    font-size: 8px;
    opacity: 0.75;
  }
  .su-kol {
    stroke: var(--color-su);
    stroke-width: 6;
  }
  .p1,
  .p2,
  .p3 { opacity: 0.8; }
  /* Sınır: dirseğin ve topuğun hemen üstü, yüzün ve mesh bölgesinin çevresi */
  .sinir {
    fill: none;
    stroke: var(--color-detay);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  /* Döngü 3,2 sn: bölge parça parça dolar, sınır belirir, bekler, söner */
  @media (prefers-reduced-motion: no-preference) {
    :global(.goster) .p1 { animation: farz-p1 3.2s 0.4s infinite both; }
    :global(.goster) .p2 { animation: farz-p2 3.2s 0.4s infinite both; }
    :global(.goster) .p3 { animation: farz-p3 3.2s 0.4s infinite both; }
    :global(.goster) .sinir { animation: farz-sinir 3.2s 0.4s infinite both; }
  }
  @keyframes farz-p1 {
    0%, 8% { opacity: 0; }
    20%, 86% { opacity: 0.8; }
    96%, 100% { opacity: 0; }
  }
  @keyframes farz-p2 {
    0%, 20% { opacity: 0; }
    32%, 86% { opacity: 0.8; }
    96%, 100% { opacity: 0; }
  }
  @keyframes farz-p3 {
    0%, 32% { opacity: 0; }
    44%, 86% { opacity: 0.8; }
    96%, 100% { opacity: 0; }
  }
  @keyframes farz-sinir {
    0%, 46% { opacity: 0; }
    56%, 86% { opacity: 1; }
    96%, 100% { opacity: 0; }
  }
</style>
