---
/*
 * Uygulamanın "Ezan Vakitleri" ekranının HTML/CSS ile yeniden çizimi — TASARIM.md §6.3.
 * İçerik gerçek uygulamadan (assets/app_screenshots/3): İstanbul/Fatih, 6 vakit,
 * içinde bulunulan vakit vurgusu ve bir sonraki vakte kalan süre.
 * Saat kurgusu tutarlıdır: 11.38'de Güneş vaktindeyiz; Öğle'ye (13.23) 1 sa 45 dk var.
 */
const vakitler = [
  { ad: 'İmsak', saat: '06:31', aktif: false },
  { ad: 'Güneş', saat: '07:56', aktif: true },
  { ad: 'Öğle', saat: '13:23', aktif: false },
  { ad: 'İkindi', saat: '16:12', aktif: false },
  { ad: 'Akşam', saat: '18:39', aktif: false },
  { ad: 'Yatsı', saat: '20:00', aktif: false },
];

const sekmeler = ['Akış', 'Asistan', 'Vakitler', 'Zikir', 'Profil'];
---

<figure
  class="telefon"
  role="img"
  aria-label="İbadet Rehberim uygulamasının namaz vakitleri ekranı: İstanbul Fatih için altı vakit listesi ve bir sonraki vakte kalan süre"
>
  <div class="govde" aria-hidden="true">
    <div class="ekran">
      <div class="durum rakam">
        <span>11:38</span>
        <span class="ada"></span>
        <span class="pil-grup">
          <span class="cubuklar"><i></i><i></i><i></i><i></i></span>
          <span class="pil"><i></i></span>
        </span>
      </div>

      <p class="baslik">Ezan Vakitleri</p>

      <div class="konum">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>İstanbul, Fatih</span>
        <span class="tarih">11 Şubat, Çarşamba</span>
      </div>

      <ul class="liste">
        {
          vakitler.map((vakit) => (
            <li class:list={['satir', 'rakam', { aktif: vakit.aktif }]}>
              <span>{vakit.ad}</span>
              <span class="saat">{vakit.saat}</span>
            </li>
          ))
        }
      </ul>

      <div class="kalan">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Kalan Süre</span>
        <strong class="rakam">1 Saat 45 Dakika</strong>
      </div>

      <div class="sekme-cubugu">
        {
          sekmeler.map((sekme) => (
            <span class:list={['sekme', { secili: sekme === 'Vakitler' }]}>
              <i></i>
              {sekme}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</figure>

<style>
  .telefon {
    width: min(85%, 340px);
    margin-inline: auto;
  }

  /* Çerçeve */
  .govde {
    background: #1b222c;
    border-radius: 46px;
    padding: 10px;
    box-shadow: 0 24px 48px -24px rgb(32 40 26 / 35%);
  }
  .ekran {
    position: relative;
    background: var(--color-zemin);
    border-radius: 37px;
    padding: 12px 16px 10px;
    overflow: hidden;
  }

  /* Durum çubuğu + kamera adası */
  .durum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 500;
    padding-inline: 8px;
  }
  .ada {
    width: 74px;
    height: 22px;
    background: #1b222c;
    border-radius: 999px;
  }
  .pil-grup {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .cubuklar {
    display: inline-flex;
    align-items: flex-end;
    gap: 1.5px;
  }
  .cubuklar i {
    width: 2.5px;
    background: var(--color-murekkep);
    border-radius: 1px;
  }
  .cubuklar i:nth-child(1) { height: 4px; }
  .cubuklar i:nth-child(2) { height: 6px; }
  .cubuklar i:nth-child(3) { height: 8px; }
  .cubuklar i:nth-child(4) { height: 10px; }
  .pil {
    width: 22px;
    height: 11px;
    border: 1.5px solid color-mix(in srgb, var(--color-murekkep) 55%, transparent);
    border-radius: 3.5px;
    padding: 1.5px;
    display: inline-flex;
  }
  .pil i {
    width: 70%;
    background: var(--color-murekkep);
    border-radius: 1.5px;
  }

  .baslik {
    margin-top: 18px;
    text-align: center;
    font-weight: 500;
    font-size: 1.05rem;
  }

  /* Konum satırı */
  .konum {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--color-yuzey);
    border: 1px solid color-mix(in srgb, var(--color-detay) 25%, transparent);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 0.82rem;
    font-weight: 500;
  }
  .konum svg {
    width: 14px;
    height: 14px;
    color: var(--color-vurgu-koyu);
    flex-shrink: 0;
  }
  .konum .tarih {
    margin-left: auto;
    font-weight: 400;
    color: var(--color-soluk);
  }

  /* Vakit listesi */
  .liste {
    margin-top: 12px;
    background: var(--color-yuzey);
    border: 1px solid color-mix(in srgb, var(--color-detay) 25%, transparent);
    border-radius: 18px;
    overflow: hidden;
  }
  .satir {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 16px;
    font-size: 0.92rem;
  }
  .satir + .satir {
    border-top: 1px solid color-mix(in srgb, var(--color-detay) 14%, transparent);
  }
  .satir .saat {
    color: var(--color-soluk);
  }
  .satir.aktif {
    background: color-mix(in srgb, var(--color-vurgu) 16%, var(--color-zemin));
    font-weight: 600;
  }
  .satir.aktif .saat {
    color: var(--color-vurgu-koyu);
    font-weight: 600;
  }

  /* Kalan süre */
  .kalan {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 7px;
    justify-content: center;
    background: var(--color-yuzey);
    border: 1px solid color-mix(in srgb, var(--color-vurgu) 35%, transparent);
    border-radius: 999px;
    padding: 9px 12px;
    font-size: clamp(0.72rem, 3.2vw, 0.85rem);
    white-space: nowrap;
  }
  .kalan svg {
    width: 15px;
    height: 15px;
    color: var(--color-vurgu-koyu);
    flex-shrink: 0;
  }
  .kalan strong {
    color: var(--color-vurgu-koyu);
    font-weight: 600;
  }

  /* Alt sekme çubuğu */
  .sekme-cubugu {
    margin-top: 14px;
    display: flex;
    justify-content: space-between;
    padding: 8px 6px 4px;
    border-top: 1px solid color-mix(in srgb, var(--color-detay) 14%, transparent);
  }
  .sekme {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--color-soluk);
    min-width: 44px;
  }
  .sekme i {
    width: 26px;
    height: 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-soluk) 28%, transparent);
  }
  .sekme.secili {
    color: var(--color-vurgu-koyu);
    font-weight: 600;
  }
  .sekme.secili i {
    background: color-mix(in srgb, var(--color-vurgu) 30%, var(--color-zemin));
    outline: 1.5px solid var(--color-vurgu-koyu);
    outline-offset: -1.5px;
  }
</style>
