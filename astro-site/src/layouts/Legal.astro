---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import GeriDon from '../components/GeriDon.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description} ogType="article">
  <main class="mx-auto max-w-[720px] px-5 py-12 md:px-8 md:py-16">
    <GeriDon class="mb-6" />
    <h1 class="text-[clamp(2rem,4vw,2.6rem)]">
      {frontmatter.pageTitle}
    </h1>
    {frontmatter.updated && <p class="mt-3 text-soluk italic">{frontmatter.updated}</p>}
    <article class="legal mt-8">
      <slot />
    </article>
  </main>
  <Footer />
</Base>

<style>
  /* Hukuki metin tipografisi — sakin okuma düzeni */
  .legal :global(p),
  .legal :global(li) {
    line-height: 1.7;
    color: var(--color-murekkep);
  }
  .legal :global(p + p) {
    margin-top: 0.85rem;
  }
  .legal :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.35rem;
  }
  .legal :global(strong) {
    font-weight: 600;
  }
  .legal :global(ul) {
    margin-top: 0.85rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal :global(li + li) {
    margin-top: 0.85rem;
  }
  .legal :global(blockquote) {
    margin-top: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--color-detay) 25%, transparent);
    border-radius: 16px;
    background: var(--color-yuzey);
    padding: 1.25rem;
    font-style: italic;
  }
  .legal :global(a) {
    color: var(--color-vurgu-koyu);
    text-decoration: underline;
  }
</style>
